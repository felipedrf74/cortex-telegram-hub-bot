# Nexus Hub — local Docker sandbox env template
#
# Copy this file to `.env.local` (which is gitignored) and fill in the
# three real-key slots near the bottom before running `./scripts/local-up.sh`.
#
# This file is paired with `docker-compose.local.yml`. The Node and Python
# containers both read `/app/.env` and `/engine/.env` which are bind-mounted
# from `.env.local` at the repo root.
#
# DO NOT commit `.env.local` to git. The `.gitignore` already blocks it.
#
# ─── Runtime mode ────────────────────────────────────────────────────────
NODE_ENV=development
ENV=development
STAGING=false
LOG_LEVEL=info
TIMEZONE=Europe/Lisbon

# ─── Ports (host:container both 8200 / 8100 by default) ──────────────────
# Override with NEXUS_LOCAL_PORT_TS / NEXUS_LOCAL_PORT_PY only if a host
# port conflicts.
PORTAL_PORT=8200
PORTAL_BIND=0.0.0.0
CONTENT_ENGINE_PORT=8100
CONTENT_ENGINE_ENABLED=true

# ─── Cost + safety caps ──────────────────────────────────────────────────
# Hard daily ceiling across all providers. Keep low for local-dev.
GLOBAL_DAILY_COST_LIMIT=5.00
AI_CALL_TIMEOUT_MS=30000

# ─── iOS API + auth ──────────────────────────────────────────────────────
IOS_API_ENABLED=true
IOS_API_RATE_LIMIT=60
IOS_API_READ_RATE_LIMIT=300
# Must be 32+ bytes. Generated stub — replace if you want to test rotation.
IOS_API_JWT_SECRET=local-dev-ios-jwt-secret-change-me-000000000000000000000000
IOS_INVITE_CODE=LOCAL-DEV-INVITE
IOS_OWNER_CODE=LOCAL-DEV-OWNER

# ─── Portal admin (web dashboard) ────────────────────────────────────────
PORTAL_ENABLED=true
PORTAL_TOKEN=local-dev-portal-token
PORTAL_ALLOW_LOCAL_BYPASS=true
PORTAL_ADMIN_TOKEN=local-dev-portal-admin
# Allow /health/detailed without bearer from inside container loopback.
HEALTH_ALLOW_UNAUTHENTICATED=true

# ─── Database ────────────────────────────────────────────────────────────
# Path is the container path. The volume mount in docker-compose.local.yml
# maps ./data on the host to /app/data inside the container.
DATABASE_PATH=/app/data/local.db
# Docker Desktop bind-mounted SQLite files are safer with rollback journal
# mode than WAL. Production keeps the code default (WAL/NORMAL/mmap enabled)
# unless these envs are explicitly set.
SQLITE_JOURNAL_MODE=DELETE
SQLITE_SYNCHRONOUS=FULL
SQLITE_MMAP_SIZE=0

# ─── OAuth + encryption keys (32+ bytes each) ────────────────────────────
OAUTH_ENCRYPTION_KEY=local-dev-oauth-encryption-key-00000000000000000000000000
INTERNAL_API_SECRET=local-dev-internal-api-secret
OAUTH_REDIRECT_BASE=http://127.0.0.1:8200

# ─── Telegram bot (DISABLED in local-dev) ────────────────────────────────
# Leaving this stubbed prevents polling conflicts with the prod bot. If you
# need to test Telegram flows locally, create a separate dev bot via
# BotFather and use its token here.
TELEGRAM_BOT_TOKEN=local-dev-telegram-disabled
TELEGRAM_LEGACY_DELIVERY=false
OWNER_TELEGRAM_ID=100000001
TELEGRAM_ALLOWED_USER_IDS=100000001

# ─── Feature flags ───────────────────────────────────────────────────────
PAYWALL_ENABLED=false
FINANCE_ENCRYPTION_ENABLED=false
BACKUP_ENABLED=false
NEXUS_MULTISKILL_MESH=on

# ChatV2 completion evidence is dark by default. Enable only in sandbox /
# reviewed shadow/canary runs. Runtime rows use evidence_source=runtime_route.
# Local seeded rows use evidence_source=local_sandbox_seed and are not production
# promotion proof. Rows store HMAC IDs + safe route metadata only, never raw
# user text or private context.
CHAT_V2_COMPLETION_MODE=off
CHAT_V2_SHADOW_EVIDENCE_ENABLED=false
CHAT_V2_ANSWER_CANARY_EVIDENCE_ENABLED=false
CHAT_V2_DETERMINISTIC_READ_EVIDENCE_ENABLED=false
CHAT_V2_WRITE_EVIDENCE_ENABLED=false
CHAT_V2_CLOUD_ALLOWLIST_EVIDENCE_ENABLED=false
CHAT_V2_LEGACY_RETIREMENT_EVIDENCE_ENABLED=false
CHAT_V2_EVIDENCE_HMAC_SECRET=local-dev-chat-v2-evidence-hmac-secret-change-me-000000
CHAT_V2_CLOUD_ALLOWLIST_HMAC_SECRET=local-dev-chat-v2-cloud-allowlist-hmac-secret-change-me-000000

# ChatCoreV2 runtime rollout levers. IMPORTANT: orchestrator mode accepts only
# off|shadow|canary|on. Never set CHAT_CORE_V2_ORCHESTRATOR_MODE=enforce; that
# parses as off. Write fallback blocking is armed separately by
# CHAT_CORE_V2_ACTION_GATEWAY_MODE=enforce plus LEGACY_WRITE_FALLTHROUGH_BLOCK.
CHAT_CORE_V2_ORCHESTRATOR_MODE=off
CHAT_CORE_V2_ALLOWED_DOMAINS=training,cooking,content,finance,tasks,secretary,general
CHAT_CORE_V2_ACTION_GATEWAY_MODE=off
CHAT_CORE_V2_LEGACY_WRITE_FALLTHROUGH_BLOCK=on
CHAT_CORE_V2_ALLOW_DETERMINISTIC_READS=false
CHAT_CORE_V2_ALLOW_WRITE_PREVIEWS=false
CHAT_CORE_V2_ALLOW_WRITE_EXECUTION=false
CHAT_CORE_V2_ALLOW_CLOUD_FALLBACK=false
CHAT_CORE_V2_QUEUE_FALLBACK_MODE=off
# Default-on production safety valve. Set to false only for isolated local
# parity/evidence runs where stale local fallback counters would self-demote the
# synthetic tenant before observations complete.
CHAT_CORE_V2_AUTO_REVERT_EVAL=true

# Web-grounded research retries are bounded and apply only after the safe public
# query packet has been built. They never retry denied private-context queries.
# If ANTHROPIC_ENABLED=true and a key is configured, ChatV2 internet research may
# use Anthropic web search only after Gemini search exhausts. The fallback receives
# the same public-query prompt only, never raw Nexus context.
# If CHAT_INTERNET_RESEARCH_OPENAI_WEB_SEARCH_FALLBACK=true and OPENAI_API_KEY is
# configured, the route may use OpenAI Responses web_search after Gemini/Anthropic
# fail. This is also public-query-only and default-off to avoid surprise cost.
CHAT_INTERNET_RESEARCH_MAX_ATTEMPTS=2
CHAT_INTERNET_RESEARCH_RETRY_DELAY_MS=150
CHAT_INTERNET_RESEARCH_OPENAI_WEB_SEARCH_FALLBACK=false

# ─── AI provider keys (fill in your dev-tier keys) ───────────────────────
# Real keys with low rate limits are recommended. The $5/day cap above is
# the safety net. Leave a key blank to disable that provider; the routing
# layer will degrade gracefully.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5
ANTHROPIC_ENABLED=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Optional integrations (leave blank to skip) ─────────────────────────
# Google OAuth (calendar, gmail, drive). For local dev, create a separate
# Google Cloud project with the redirect URI http://127.0.0.1:8200/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Microsoft Outlook OAuth. Same advice — dev tenant for local testing.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REFRESH_TOKEN=

# Garmin Connect (daily coach). MFA-aware; only set if you want to exercise
# the keep-alive path locally.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_PATH=/app/data/garmin-tokens

# Content engine research APIs (optional). Leave blank to use fixture mode.
SERPAPI_API_KEY=
YOUTUBE_API_KEY=
NEWSAPI_API_KEY=
CONTENT_ENGINE_FIXTURE_MODE=1

# Apple Push Notifications (leave blank in local-dev — no real devices).
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_AUTH_KEY_P8=

# Stripe (leave blank in local-dev — paywall is disabled above).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry (optional — leave blank for local-dev).
SENTRY_DSN=
