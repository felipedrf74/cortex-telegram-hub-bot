# Install as /etc/sonarqube/backup.env, owned by root:root, mode 0600.
# An IAM role or another credential_process may replace static AWS keys.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=eu-west-1
SONAR_BACKUP_S3_ENDPOINT=https://s3-compatible.example.invalid
SONAR_BACKUP_S3_BUCKET=replace-me
SONAR_BACKUP_S3_PREFIX=nexus-hub/sonarqube
SONAR_BACKUP_AGE_RECIPIENT=age1replace-with-off-host-recipient
