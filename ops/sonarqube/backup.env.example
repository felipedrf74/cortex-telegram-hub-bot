# Install as /etc/sonarqube/backup.env, owned by root:root, mode 0600.
# The backup accepts only its dedicated IAM Roles Anywhere credential_process
# profile. Long-lived access-key environment variables and shared credential
# files are rejected.
AWS_CONFIG_FILE=/etc/sonarqube/aws-config
AWS_PROFILE=nexus-sonarqube-backup
AWS_SHARED_CREDENTIALS_FILE=/dev/null
AWS_EC2_METADATA_DISABLED=true
AWS_REGION=eu-west-1
SONAR_BACKUP_AWS_SIGNING_HELPER=/usr/local/sbin/nexus-sonarqube-aws-signing-helper
SONAR_BACKUP_AWS_SIGNING_HELPER_SHA256=replace-with-reviewed-64-character-sha256
SONAR_BACKUP_AWS_ROLE_ARN=arn:aws:iam::111122223333:role/nexus-sonarqube-backup
SONAR_RESTORE_AWS_PROFILE=nexus-sonarqube-restore
SONAR_RESTORE_AWS_ROLE_ARN=arn:aws:iam::111122223333:role/nexus-sonarqube-restore
SONAR_BACKUP_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
SONAR_BACKUP_S3_BUCKET=replace-me
SONAR_BACKUP_S3_PREFIX=nexus-hub/sonarqube
SONAR_BACKUP_AGE_RECIPIENT=age1replace-with-off-host-recipient
