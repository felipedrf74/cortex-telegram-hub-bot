# Install as /etc/nexus-sonarqube-backup.env, root:root, mode 0600.
SONAR_BACKUP_ROOT=/srv/nexus-backups/sonarqube
SONAR_STACK_DIR=/home/dominguez/sonarqube
SONAR_COMPOSE_FILE=/home/dominguez/sonarqube/docker-compose.yml
SONAR_SECRETS_FILE=/home/dominguez/sonarqube/.env
SONAR_BACKUP_SUCCESS_RECEIPT=/srv/nexus-backups/sonarqube/.state/last-success.json
