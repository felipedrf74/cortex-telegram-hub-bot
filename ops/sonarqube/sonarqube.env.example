# Install as /etc/sonarqube/sonarqube.env, owned by root:root, mode 0600.
# Generate independent random values; do not commit real values.
SONAR_DB_NAME=sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=replace-with-at-least-32-random-bytes
SONAR_AUTH_JWTBASE64HS256SECRET=replace-with-a-base64-encoded-32-byte-secret
