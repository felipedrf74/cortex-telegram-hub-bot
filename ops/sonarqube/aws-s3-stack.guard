  some %restore_profile.Properties.Tags[*] {
    Key == 'receipt-signing-public-key-sha256'
    Value.Ref == 'OwnerReceiptPublicKeySha256'
  }
  some %restore_profile.Properties.Tags[*] {
    Key == 'protected-main-template-sha256'
    Value.Ref == 'ProtectedMainTemplateSha256'
  }
}

let sonar_bucket_policy_statements = %sonar_bucket_policy.Properties.PolicyDocument.Statement[*]
let sonar_bucket_policy_statement_count = count(%sonar_bucket_policy_statements)
let deny_plaintext = %sonar_bucket_policy_statements[ Sid == 'DenyPlaintextTransport' ]
let deny_legacy_tls = %sonar_bucket_policy_statements[ Sid == 'DenyLegacyTls' ]
let deny_version_delete = %sonar_bucket_policy_statements[ Sid == 'DenyDirectVersionDeletion' ]
let deny_writer_control = %sonar_bucket_policy_statements[ Sid == 'DenyWriterBucketControlMutation' ]
let deny_writer_outside = %sonar_bucket_policy_statements[ Sid == 'DenyWriterObjectIOOutsideSonarPrefix' ]
let allow_writer_inspection = %sonar_bucket_policy_statements[ Sid == 'AllowWriterBucketInspection' ]
let allow_writer_listing = %sonar_bucket_policy_statements[ Sid == 'AllowWriterExactPrefixListing' ]
let allow_writer_objects = %sonar_bucket_policy_statements[ Sid == 'AllowWriterExactPrefixObjects' ]
let allow_restore_versions = %sonar_bucket_policy_statements[ Sid == 'AllowRestoreExactPrefixVersions' ]
let deny_plaintext_count = count(%deny_plaintext)
let deny_legacy_tls_count = count(%deny_legacy_tls)
let deny_version_delete_count = count(%deny_version_delete)
let deny_writer_control_count = count(%deny_writer_control)
let deny_writer_outside_count = count(%deny_writer_outside)
let allow_writer_inspection_count = count(%allow_writer_inspection)
let allow_writer_listing_count = count(%allow_writer_listing)
let allow_writer_objects_count = count(%allow_writer_objects)
let allow_restore_versions_count = count(%allow_restore_versions)

rule sonar_bucket_policy_is_retained_and_fail_closed {
  %sonar_bucket_policy.Type == 'AWS::S3::BucketPolicy'
  %sonar_bucket_policy.DeletionPolicy == 'Retain'
  %sonar_bucket_policy.UpdateReplacePolicy == 'Retain'
  %sonar_bucket_policy.Properties.Bucket.Ref == 'SonarBackupBucket'
  %sonar_bucket_policy.Properties.PolicyDocument.Version == '2012-10-17'
  %sonar_bucket_policy_statement_count == 9
  %deny_plaintext_count == 1
  %deny_legacy_tls_count == 1
  %deny_version_delete_count == 1
  %deny_writer_control_count == 1
  %deny_writer_outside_count == 1
  %allow_writer_inspection_count == 1
  %allow_writer_listing_count == 1
  %allow_writer_objects_count == 1
  %allow_restore_versions_count == 1
  %deny_plaintext {
    Sid == 'DenyPlaintextTransport'
    Effect == 'Deny'
    Principal == '*'
    Action == 's3:*'
    Resource == [
      {'Fn::GetAtt': 'SonarBackupBucket.Arn'},
      {'Fn::Sub': '${SonarBackupBucket.Arn}/*'}
    ]
    Condition.Bool.'aws:SecureTransport' == 'false'
    Condition.Bool.'aws:PrincipalIsAWSService' == 'false'
  }
  %deny_legacy_tls {
    Sid == 'DenyLegacyTls'
    Effect == 'Deny'
    Principal == '*'
    Action == 's3:*'
    Resource == [
      {'Fn::GetAtt': 'SonarBackupBucket.Arn'},
      {'Fn::Sub': '${SonarBackupBucket.Arn}/*'}
    ]
    Condition.NumericLessThan.'s3:TlsVersion' == 1.2
    Condition.Bool.'aws:PrincipalIsAWSService' == 'false'
  }
  %deny_version_delete {
    Sid == 'DenyDirectVersionDeletion'
    Effect == 'Deny'
    Principal == '*'
    Action == ['s3:DeleteObjectVersion']
    Resource.'Fn::Sub' == '${SonarBackupBucket.Arn}/${SonarPrefix}/*'
  }
  %deny_writer_control {
    Sid == 'DenyWriterBucketControlMutation'
    Effect == 'Deny'
    Principal.AWS.'Fn::GetAtt' == 'SonarBackupRole.Arn'
    Action == [
      's3:DeleteBucketPolicy',
      's3:PutEncryptionConfiguration',
      's3:PutBucketPolicy',
      's3:PutBucketPublicAccessBlock',
      's3:PutBucketVersioning',
      's3:PutLifecycleConfiguration'
    ]
    Resource.'Fn::GetAtt' == 'SonarBackupBucket.Arn'
  }
  %deny_writer_outside {
    Sid == 'DenyWriterObjectIOOutsideSonarPrefix'
    Effect == 'Deny'
    Principal.AWS.'Fn::GetAtt' == 'SonarBackupRole.Arn'
    Action == [
      's3:DeleteObject',
      's3:GetObject',
      's3:GetObjectVersion',
      's3:PutObject'
    ]
    NotResource.'Fn::Sub' == '${SonarBackupBucket.Arn}/${SonarPrefix}/*'
  }
  %allow_writer_inspection {
    Sid == 'AllowWriterBucketInspection'
    Effect == 'Allow'
    Principal.AWS.'Fn::GetAtt' == 'SonarBackupRole.Arn'
    Action == ['s3:GetBucketVersioning']
    Resource.'Fn::GetAtt' == 'SonarBackupBucket.Arn'
  }
  %allow_writer_listing {
    Sid == 'AllowWriterExactPrefixListing'
    Effect == 'Allow'
    Principal.AWS.'Fn::GetAtt' == 'SonarBackupRole.Arn'
    Action == ['s3:ListBucket']
    Resource.'Fn::GetAtt' == 'SonarBackupBucket.Arn'
    Condition.StringLike.'s3:prefix' == [{'Fn::Sub': '${SonarPrefix}/*'}]
  }
  %allow_writer_objects {
    Sid == 'AllowWriterExactPrefixObjects'
    Effect == 'Allow'
    Principal.AWS.'Fn::GetAtt' == 'SonarBackupRole.Arn'
    Action == ['s3:DeleteObject', 's3:GetObject', 's3:GetObjectVersion', 's3:PutObject']
    Resource == [
      {'Fn::Sub': '${SonarBackupBucket.Arn}/${SonarPrefix}/daily/*'},
      {'Fn::Sub': '${SonarBackupBucket.Arn}/${SonarPrefix}/weekly/*'}
    ]
  }
  %allow_restore_versions {
    Sid == 'AllowRestoreExactPrefixVersions'
    Effect == 'Allow'
    Principal.AWS.'Fn::GetAtt' == 'SonarRestoreRole.Arn'
    Action == ['s3:GetObjectVersion']
    Resource == [
      {'Fn::Sub': '${SonarBackupBucket.Arn}/${SonarPrefix}/daily/*'},
      {'Fn::Sub': '${SonarBackupBucket.Arn}/${SonarPrefix}/weekly/*'}
    ]
  }
}

rule sonar_receipt_digests_are_visible_outputs {
  Outputs.BucketName.Value.Ref == 'SonarBackupBucket'
  Outputs.BucketArn.Value.'Fn::GetAtt' == 'SonarBackupBucket.Arn'
  Outputs.SonarPrefix.Value.Ref == 'SonarPrefix'
  Outputs.BackupPrincipalArn.Value.'Fn::GetAtt' == 'SonarBackupRole.Arn'
  Outputs.RestorePrincipalArn.Value.'Fn::GetAtt' == 'SonarRestoreRole.Arn'
  Outputs.RolesAnywhereTrustAnchorArn.Value.'Fn::GetAtt' == 'SonarRolesAnywhereTrustAnchor.TrustAnchorArn'
  Outputs.RolesAnywhereCrlId.Value.Ref == 'SonarRolesAnywhereCertificateRevocationList'
  Outputs.RolesAnywhereCrlSha256.Value.Ref == 'CertificateRevocationListSha256'
  Outputs.RolesAnywhereActivationRollbackAlarmArn.Value.'Fn::GetAtt' == 'SonarRolesAnywhereActivationRollbackAlarm.Arn'
  Outputs.BackupRolesAnywhereProfileArn.Value.'Fn::GetAtt' == 'SonarBackupRolesAnywhereProfile.ProfileArn'
  Outputs.RestoreRolesAnywhereProfileArn.Value.'Fn::GetAtt' == 'SonarRestoreRolesAnywhereProfile.ProfileArn'
  Outputs.RolesAnywhereActivation.Value.Ref == 'RolesAnywhereActivation'
  Outputs.RolesAnywhereActivationReceiptSha256.Value.Ref == 'RolesAnywhereActivationReceiptSha256'
  Outputs.LifecycleActivation.Value.Ref == 'LifecycleActivation'
  Outputs.LifecycleBootstrapReceiptSha256.Value.Ref == 'LifecycleBootstrapReceiptSha256'
  Outputs.ProtectedMainTemplateSha256.Value.Ref == 'ProtectedMainTemplateSha256'
  Outputs.OwnerReceiptKeyId.Value.Ref == 'OwnerReceiptKeyId'
  Outputs.OwnerReceiptPublicKeySha256.Value.Ref == 'OwnerReceiptPublicKeySha256'
  Outputs.S3Endpoint.Value.'Fn::Sub' == 'https://s3.${AWS::Region}.${AWS::URLSuffix}'
}
