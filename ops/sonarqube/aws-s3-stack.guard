let sonar_bucket = Resources.SonarBackupBucket
let sonar_bucket_policy = Resources.SonarBackupBucketPolicy
let backup_role = Resources.SonarBackupRole
let restore_role = Resources.SonarRestoreRole
let backup_profile = Resources.SonarBackupRolesAnywhereProfile
let restore_profile = Resources.SonarRestoreRolesAnywhereProfile
let trust_anchor = Resources.SonarRolesAnywhereTrustAnchor
let crl = Resources.SonarRolesAnywhereCertificateRevocationList
let activation_alarm = Resources.SonarRolesAnywhereActivationRollbackAlarm
let sonar_roles = Resources.*[ Type == 'AWS::IAM::Role' ]
let sonar_profiles = Resources.*[ Type == 'AWS::RolesAnywhere::Profile' ]
let access_keys = Resources.*[ Type == 'AWS::IAM::AccessKey' ]
let iam_users = Resources.*[ Type == 'AWS::IAM::User' ]
let all_resources = Resources.*
let all_parameters = Parameters.*
let all_outputs = Outputs.*
let sonar_role_count = count(%sonar_roles)
let sonar_profile_count = count(%sonar_profiles)
let resource_count = count(%all_resources)
let parameter_count = count(%all_parameters)
let output_count = count(%all_outputs)
let sonar_bucket_tag_count = count(%sonar_bucket.Properties.Tags[*])
let trust_anchor_tag_count = count(%trust_anchor.Properties.Tags[*])
let crl_tag_count = count(%crl.Properties.Tags[*])

rule sonar_receipt_parameters_are_strict_and_disabled_first {
  %parameter_count == 15
  %output_count == 19
  Parameters.ProtectedMainTemplateSha256.Type == 'String'
  Parameters.ProtectedMainTemplateSha256.AllowedPattern == '^[0-9a-f]{64}$'
  Parameters.TrustAnchorCertificateData.Type == 'String'
  Parameters.TrustAnchorCertificateData.MaxLength == 4096
  Parameters.CertificateRevocationListData.Type == 'String'
  Parameters.CertificateRevocationListData.MaxLength == 4096
  Parameters.CertificateRevocationListSha256.Type == 'String'
  Parameters.CertificateRevocationListSha256.AllowedPattern == '^[0-9a-f]{64}$'
  Parameters.OwnerReceiptKeyId.Type == 'String'
  Parameters.OwnerReceiptKeyId.MinLength == 1
  Parameters.OwnerReceiptKeyId.MaxLength == 128
  Parameters.OwnerReceiptKeyId.AllowedPattern == '^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$'
  Parameters.OwnerReceiptPublicKeySha256.Type == 'String'
  Parameters.OwnerReceiptPublicKeySha256.AllowedPattern == '^[0-9a-f]{64}$'
  Parameters.RolesAnywhereActivation.Default == 'DISABLED'
  Parameters.RolesAnywhereActivation.AllowedValues == ['DISABLED', 'ENABLED']
  Parameters.RolesAnywhereActivationReceiptSha256.Default == ''
  Parameters.RolesAnywhereActivationReceiptSha256.AllowedPattern == '^$|^[0-9a-f]{64}$'
  Parameters.LifecycleActivation.Default == 'DISABLED'
  Parameters.LifecycleActivation.AllowedValues == ['DISABLED', 'ENABLED']
  Parameters.LifecycleBootstrapReceiptSha256.Default == ''
  Parameters.LifecycleBootstrapReceiptSha256.AllowedPattern == '^$|^[0-9a-f]{64}$'
  Rules.RolesAnywhereActivationRequiresReceipt.RuleCondition.'Fn::Equals'[0].Ref == 'RolesAnywhereActivation'
  Rules.RolesAnywhereActivationRequiresReceipt.RuleCondition.'Fn::Equals'[1] == 'ENABLED'
  Rules.RolesAnywhereActivationRequiresReceipt.Assertions[0].Assert.'Fn::Not'[0].'Fn::Equals'[0].Ref == 'RolesAnywhereActivationReceiptSha256'
  Rules.RolesAnywhereActivationRequiresReceipt.Assertions[0].Assert.'Fn::Not'[0].'Fn::Equals'[1] == ''
  Rules.DisabledRolesAnywhereRejectsReceipt.RuleCondition.'Fn::Equals'[0].Ref == 'RolesAnywhereActivation'
  Rules.DisabledRolesAnywhereRejectsReceipt.RuleCondition.'Fn::Equals'[1] == 'DISABLED'
  Rules.DisabledRolesAnywhereRejectsReceipt.Assertions[0].Assert.'Fn::Equals'[0].Ref == 'RolesAnywhereActivationReceiptSha256'
  Rules.DisabledRolesAnywhereRejectsReceipt.Assertions[0].Assert.'Fn::Equals'[1] == ''
  Rules.LifecycleActivationRequiresFirstBackup.RuleCondition.'Fn::Equals'[0].Ref == 'LifecycleActivation'
  Rules.LifecycleActivationRequiresFirstBackup.RuleCondition.'Fn::Equals'[1] == 'ENABLED'
  Rules.LifecycleActivationRequiresFirstBackup.Assertions[0].Assert.'Fn::Not'[0].'Fn::Equals'[0].Ref == 'LifecycleBootstrapReceiptSha256'
  Rules.LifecycleActivationRequiresFirstBackup.Assertions[0].Assert.'Fn::Not'[0].'Fn::Equals'[1] == ''
  Rules.DisabledLifecycleRejectsReceipt.RuleCondition.'Fn::Equals'[0].Ref == 'LifecycleActivation'
  Rules.DisabledLifecycleRejectsReceipt.RuleCondition.'Fn::Equals'[1] == 'DISABLED'
  Rules.DisabledLifecycleRejectsReceipt.Assertions[0].Assert.'Fn::Equals'[0].Ref == 'LifecycleBootstrapReceiptSha256'
  Rules.DisabledLifecycleRejectsReceipt.Assertions[0].Assert.'Fn::Equals'[1] == ''
}

rule sonar_backup_bucket_is_private_versioned_retained_and_isolated {
  %resource_count == 9
  %sonar_bucket_tag_count == 7
  %sonar_bucket.Type == 'AWS::S3::Bucket'
  %sonar_bucket.DeletionPolicy == 'Retain'
  %sonar_bucket.UpdateReplacePolicy == 'Retain'
  %sonar_bucket.Properties.VersioningConfiguration.Status == 'Enabled'
  %sonar_bucket.Properties.BucketEncryption.ServerSideEncryptionConfiguration[0].ServerSideEncryptionByDefault.SSEAlgorithm == 'AES256'
  %sonar_bucket.Properties.OwnershipControls.Rules == [{ObjectOwnership: 'BucketOwnerEnforced'}]
  %sonar_bucket.Properties.PublicAccessBlockConfiguration.BlockPublicAcls == true
  %sonar_bucket.Properties.PublicAccessBlockConfiguration.BlockPublicPolicy == true
  %sonar_bucket.Properties.PublicAccessBlockConfiguration.IgnorePublicAcls == true
  %sonar_bucket.Properties.PublicAccessBlockConfiguration.RestrictPublicBuckets == true
  some %sonar_bucket.Properties.Tags[*] {
    Key == 'application'
    Value == 'nexus-hub'
  }
  some %sonar_bucket.Properties.Tags[*] {
    Key == 'purpose'
    Value == 'encrypted-sonarqube-backup'
  }
  some %sonar_bucket.Properties.Tags[*] {
    Key == 'isolation-boundary'
    Value == 'separate-from-application-dr'
  }
  some %sonar_bucket.Properties.Tags[*] {
    Key == 'owner-activation-receipt-sha256'
    Value.Ref == 'RolesAnywhereActivationReceiptSha256'
  }
  some %sonar_bucket.Properties.Tags[*] {
    Key == 'first-backup-receipt-sha256'
    Value.Ref == 'LifecycleBootstrapReceiptSha256'
  }
  some %sonar_bucket.Properties.Tags[*] {
    Key == 'receipt-signing-public-key-sha256'
    Value.Ref == 'OwnerReceiptPublicKeySha256'
  }
  some %sonar_bucket.Properties.Tags[*] {
    Key == 'protected-main-template-sha256'
    Value.Ref == 'ProtectedMainTemplateSha256'
  }
}

let lifecycle_rules = %sonar_bucket.Properties.LifecycleConfiguration.Rules[*]
let lifecycle_rule_count = count(%lifecycle_rules)
let hygiene_rules = %lifecycle_rules[ Id == 'SonarNamespaceHygiene' ]
let daily_rules = %lifecycle_rules[ Id == 'SonarDailyNoncurrentVersionRetention' ]
let weekly_rules = %lifecycle_rules[ Id == 'SonarWeeklyNoncurrentVersionRetention' ]
let hygiene_count = count(%hygiene_rules)
let daily_count = count(%daily_rules)
let weekly_count = count(%weekly_rules)

rule sonar_lifecycle_is_exact_and_disabled_first {
  %lifecycle_rule_count == 3
  %hygiene_count == 1
  %daily_count == 1
  %weekly_count == 1
  %hygiene_rules {
    Prefix.'Fn::Sub' == '${SonarPrefix}/'
    Status == 'Enabled'
    AbortIncompleteMultipartUpload.DaysAfterInitiation == 7
    ExpirationDate not exists
    ExpirationInDays not exists
    ExpiredObjectDeleteMarker not exists
    NoncurrentVersionExpiration not exists
    NoncurrentVersionExpirationInDays not exists
    NoncurrentVersionTransition not exists
    NoncurrentVersionTransitions not exists
    ObjectSizeGreaterThan not exists
    ObjectSizeLessThan not exists
    TagFilters not exists
    Transition not exists
    Transitions not exists
  }
  %daily_rules {
    Prefix.'Fn::Sub' == '${SonarPrefix}/daily/'
    Status.'Fn::If' == ['EnableLifecycle', 'Enabled', 'Disabled']
    ExpiredObjectDeleteMarker == true
    NoncurrentVersionExpiration.NoncurrentDays == 35
    AbortIncompleteMultipartUpload not exists
    ExpirationDate not exists
    ExpirationInDays not exists
    NoncurrentVersionExpirationInDays not exists
    NoncurrentVersionExpiration.NewerNoncurrentVersions not exists
    NoncurrentVersionTransition not exists
    NoncurrentVersionTransitions not exists
    ObjectSizeGreaterThan not exists
    ObjectSizeLessThan not exists
    TagFilters not exists
    Transition not exists
    Transitions not exists
  }
  %weekly_rules {
    Prefix.'Fn::Sub' == '${SonarPrefix}/weekly/'
    Status.'Fn::If' == ['EnableLifecycle', 'Enabled', 'Disabled']
    ExpiredObjectDeleteMarker == true
    NoncurrentVersionExpiration.NoncurrentDays == 120
    AbortIncompleteMultipartUpload not exists
    ExpirationDate not exists
    ExpirationInDays not exists
    NoncurrentVersionExpirationInDays not exists
    NoncurrentVersionExpiration.NewerNoncurrentVersions not exists
    NoncurrentVersionTransition not exists
    NoncurrentVersionTransitions not exists
    ObjectSizeGreaterThan not exists
    ObjectSizeLessThan not exists
    TagFilters not exists
    Transition not exists
    Transitions not exists
  }
}

rule sonar_backup_has_only_two_distinct_temporary_identity_roles {
  %sonar_role_count == 2
  %sonar_profile_count == 2
  %access_keys empty
  %iam_users empty
  Rules.DistinctCertificateSubjects.Assertions[0].Assert.'Fn::Not'[0].'Fn::Equals'[0].Ref == 'BackupCertificateSubjectCommonName'
  Rules.DistinctCertificateSubjects.Assertions[0].Assert.'Fn::Not'[0].'Fn::Equals'[1].Ref == 'RestoreCertificateSubjectCommonName'
}

let backup_trust = %backup_role.Properties.AssumeRolePolicyDocument.Statement[0]
let restore_trust = %restore_role.Properties.AssumeRolePolicyDocument.Statement[0]
let backup_trust_statement_count = count(%backup_role.Properties.AssumeRolePolicyDocument.Statement[*])
let restore_trust_statement_count = count(%restore_role.Properties.AssumeRolePolicyDocument.Statement[*])
let backup_trust_actions = %backup_trust.Action[*]
let restore_trust_actions = %restore_trust.Action[*]
let backup_trust_action_count = count(%backup_trust_actions)
let restore_trust_action_count = count(%restore_trust_actions)

rule sonar_roles_anywhere_trust_is_exact {
  %backup_role.Type == 'AWS::IAM::Role'
  %restore_role.Type == 'AWS::IAM::Role'
  %backup_role.Properties.Path == '/nexus/sonarqube/'
  %restore_role.Properties.Path == '/nexus/sonarqube/'
  %backup_role.Properties.MaxSessionDuration == 3600
  %restore_role.Properties.MaxSessionDuration == 3600
  %backup_role.Properties.AssumeRolePolicyDocument.Version == '2012-10-17'
  %restore_role.Properties.AssumeRolePolicyDocument.Version == '2012-10-17'
  %backup_trust_statement_count == 1
  %restore_trust_statement_count == 1
  %backup_trust_action_count == 3
  %restore_trust_action_count == 3
  %backup_trust.Action == ['sts:AssumeRole', 'sts:SetSourceIdentity', 'sts:TagSession']
  %restore_trust.Action == ['sts:AssumeRole', 'sts:SetSourceIdentity', 'sts:TagSession']
  %backup_trust.Principal.Service == 'rolesanywhere.amazonaws.com'
  %restore_trust.Principal.Service == 'rolesanywhere.amazonaws.com'
  %backup_trust.Condition.ArnEquals.'aws:SourceArn'.'Fn::GetAtt' == 'SonarRolesAnywhereTrustAnchor.TrustAnchorArn'
  %restore_trust.Condition.ArnEquals.'aws:SourceArn'.'Fn::GetAtt' == 'SonarRolesAnywhereTrustAnchor.TrustAnchorArn'
  %backup_trust.Condition.StringEquals.'aws:SourceAccount'.Ref == 'AWS::AccountId'
  %restore_trust.Condition.StringEquals.'aws:SourceAccount'.Ref == 'AWS::AccountId'
  %backup_trust.Condition.StringEquals.'aws:PrincipalTag/x509Issuer/CN'.Ref == 'CertificateIssuerCommonName'
  %restore_trust.Condition.StringEquals.'aws:PrincipalTag/x509Issuer/CN'.Ref == 'CertificateIssuerCommonName'
  %backup_trust.Condition.StringEquals.'aws:PrincipalTag/x509Subject/CN'.Ref == 'BackupCertificateSubjectCommonName'
  %restore_trust.Condition.StringEquals.'aws:PrincipalTag/x509Subject/CN'.Ref == 'RestoreCertificateSubjectCommonName'
  %trust_anchor.Type == 'AWS::RolesAnywhere::TrustAnchor'
  %trust_anchor.Properties.Enabled.'Fn::If' == ['EnableRolesAnywhere', true, false]
  %trust_anchor.Properties.Name.'Fn::Sub' == '${AWS::StackName}-ca'
  %trust_anchor.Properties.Source.SourceType == 'CERTIFICATE_BUNDLE'
  %trust_anchor.Properties.Source.SourceData.X509CertificateData.Ref == 'TrustAnchorCertificateData'
  %trust_anchor_tag_count == 3
  some %trust_anchor.Properties.Tags[*] {
    Key == 'application'
    Value == 'nexus-hub'
  }
  some %trust_anchor.Properties.Tags[*] {
    Key == 'purpose'
    Value == 'sonarqube-backup-authentication'
  }
  some %trust_anchor.Properties.Tags[*] {
    Key == 'isolation-boundary'
    Value == 'separate-from-application-dr'
  }
  %crl.Type == 'AWS::RolesAnywhere::CRL'
  %crl.Properties.CrlData.Ref == 'CertificateRevocationListData'
  %crl.Properties.Enabled.'Fn::If' == ['EnableRolesAnywhere', true, false]
  %crl.Properties.Name.'Fn::Sub' == '${AWS::StackName}-crl'
  %crl.Properties.TrustAnchorArn.'Fn::GetAtt' == 'SonarRolesAnywhereTrustAnchor.TrustAnchorArn'
  %crl_tag_count == 4
  some %crl.Properties.Tags[*] {
    Key == 'application'
    Value == 'nexus-hub'
  }
  some %crl.Properties.Tags[*] {
    Key == 'purpose'
    Value == 'sonarqube-backup-revocation'
  }
  some %crl.Properties.Tags[*] {
    Key == 'isolation-boundary'
    Value == 'separate-from-application-dr'
  }
  some %crl.Properties.Tags[*] {
    Key == 'crl-sha256'
    Value.Ref == 'CertificateRevocationListSha256'
  }
  %activation_alarm.Type == 'AWS::CloudWatch::Alarm'
  %activation_alarm.Properties.AlarmName.'Fn::Sub' == '${AWS::StackName}-roles-anywhere-activation-rollback'
  %activation_alarm.Properties.ComparisonOperator == 'LessThanThreshold'
  %activation_alarm.Properties.DatapointsToAlarm == 4
  %activation_alarm.Properties.Dimensions == [
    {Name: 'StackName', Value: {Ref: 'AWS::StackName'}}
  ]
  %activation_alarm.Properties.EvaluationPeriods == 4
  %activation_alarm.Properties.MetricName == 'ActivationLease'
  %activation_alarm.Properties.Namespace == 'Nexus/SonarQube'
  %activation_alarm.Properties.Period == 30
  %activation_alarm.Properties.Statistic == 'Minimum'
  %activation_alarm.Properties.Threshold == 1
  %activation_alarm.Properties.TreatMissingData == 'breaching'
  %activation_alarm.Properties.Unit == 'Count'
}

let backup_inline_policies = %backup_role.Properties.Policies[*]
let restore_inline_policies = %restore_role.Properties.Policies[*]
let backup_policy_count = count(%backup_inline_policies)
let restore_policy_count = count(%restore_inline_policies)
let backup_statements = %backup_inline_policies[ PolicyName == 'NexusSonarBackupWriter' ].PolicyDocument.Statement[*]
let restore_statements = %restore_inline_policies[ PolicyName == 'NexusSonarBackupRestore' ].PolicyDocument.Statement[*]
let backup_statement_count = count(%backup_statements)
let restore_statement_count = count(%restore_statements)
let backup_inspect = %backup_statements[ Sid == 'InspectBucketVersioning' ]
let backup_list = %backup_statements[ Sid == 'ListExactSonarPrefix' ]
let backup_objects = %backup_statements[ Sid == 'SonarBackupObjectIO' ]
let restore_objects = %restore_statements[ Sid == 'ReadExactSonarVersions' ]
let backup_inspect_count = count(%backup_inspect)
let backup_list_count = count(%backup_list)
let backup_objects_count = count(%backup_objects)
let restore_objects_count = count(%restore_objects)
let backup_inspect_actions = %backup_inspect.Action[*]
let backup_list_actions = %backup_list.Action[*]
let backup_object_actions = %backup_objects.Action[*]
let restore_object_actions = %restore_objects.Action[*]
let backup_list_action_count = count(%backup_list_actions)
let backup_inspect_action_count = count(%backup_inspect_actions)
let backup_object_action_count = count(%backup_object_actions)
let restore_object_action_count = count(%restore_object_actions)

rule sonar_identity_policies_are_exact_and_version_pinned {
  %backup_policy_count == 1
  %restore_policy_count == 1
  %backup_statement_count == 3
  %restore_statement_count == 1
  %backup_inspect_count == 1
  %backup_list_count == 1
  %backup_objects_count == 1
  %restore_objects_count == 1
  %backup_inline_policies.PolicyDocument.Version == '2012-10-17'
  %restore_inline_policies.PolicyDocument.Version == '2012-10-17'
  %backup_inspect_action_count == 1
  %backup_inspect.Effect == 'Allow'
  %backup_inspect.Action == ['s3:GetBucketVersioning']
  %backup_inspect.Resource.'Fn::GetAtt' == 'SonarBackupBucket.Arn'
  %backup_list_action_count == 1
  %backup_list.Effect == 'Allow'
  %backup_list.Action == ['s3:ListBucket']
  %backup_list.Resource.'Fn::GetAtt' == 'SonarBackupBucket.Arn'
  %backup_list.Condition.StringLike.'s3:prefix' == [{'Fn::Sub': '${SonarPrefix}/*'}]
  %backup_object_action_count == 4
  %backup_objects.Effect == 'Allow'
  %backup_objects.Action == ['s3:DeleteObject', 's3:GetObject', 's3:GetObjectVersion', 's3:PutObject']
  %backup_objects.Resource == [
    {'Fn::Sub': '${SonarBackupBucket.Arn}/${SonarPrefix}/daily/*'},
    {'Fn::Sub': '${SonarBackupBucket.Arn}/${SonarPrefix}/weekly/*'}
  ]
  %restore_object_action_count == 1
  %restore_objects.Effect == 'Allow'
  %restore_objects.Action == ['s3:GetObjectVersion']
  %restore_objects.Resource == [
    {'Fn::Sub': '${SonarBackupBucket.Arn}/${SonarPrefix}/daily/*'},
    {'Fn::Sub': '${SonarBackupBucket.Arn}/${SonarPrefix}/weekly/*'}
  ]
}

let backup_session = json_parse(%backup_profile.Properties.SessionPolicy.'Fn::Sub')
let restore_session = json_parse(%restore_profile.Properties.SessionPolicy.'Fn::Sub')
let backup_session_statements = %backup_session.Statement[*]
let restore_session_statements = %restore_session.Statement[*]
let backup_session_statement_count = count(%backup_session_statements)
let restore_session_statement_count = count(%restore_session_statements)
let backup_session_list = %backup_session_statements[
  some Action[*] == 's3:ListBucket'
]
let backup_session_inspect = %backup_session_statements[
  Action == 's3:GetBucketVersioning'
]
let backup_session_objects = %backup_session_statements[
  some Action[*] == 's3:PutObject'
]
let restore_session_objects = %restore_session_statements[*]
let backup_session_list_actions = %backup_session_list.Action[*]
let backup_session_inspect_actions = %backup_session_inspect.Action[*]
let backup_session_object_actions = %backup_session_objects.Action[*]
let restore_session_object_actions = %restore_session_objects.Action[*]
let backup_session_list_action_count = count(%backup_session_list_actions)
let backup_session_inspect_count = count(%backup_session_inspect)
let backup_session_object_action_count = count(%backup_session_object_actions)
let restore_session_object_action_count = count(%restore_session_object_actions)
let backup_role_tag_count = count(%backup_role.Properties.Tags[*])
let restore_role_tag_count = count(%restore_role.Properties.Tags[*])
let backup_profile_tag_count = count(%backup_profile.Properties.Tags[*])
let restore_profile_tag_count = count(%restore_profile.Properties.Tags[*])

rule sonar_profiles_are_single_role_short_lived_and_exact {
  %backup_profile.Type == 'AWS::RolesAnywhere::Profile'
  %restore_profile.Type == 'AWS::RolesAnywhere::Profile'
  %backup_profile.Properties.AcceptRoleSessionName == false
  %restore_profile.Properties.AcceptRoleSessionName == false
  %backup_profile.Properties.DurationSeconds == 900
  %restore_profile.Properties.DurationSeconds == 900
  %backup_profile.Properties.Enabled.'Fn::If' == ['EnableRolesAnywhere', true, false]
  %restore_profile.Properties.Enabled.'Fn::If' == ['EnableRolesAnywhere', true, false]
  %backup_profile.DependsOn == 'SonarRolesAnywhereCertificateRevocationList'
  %restore_profile.DependsOn == 'SonarRolesAnywhereCertificateRevocationList'
  %backup_profile.Properties.Name.'Fn::Sub' == '${AWS::StackName}-backup'
  %restore_profile.Properties.Name.'Fn::Sub' == '${AWS::StackName}-restore'
  %backup_profile.Properties.RoleArns == [{'Fn::GetAtt': 'SonarBackupRole.Arn'}]
  %restore_profile.Properties.RoleArns == [{'Fn::GetAtt': 'SonarRestoreRole.Arn'}]
  %backup_profile.Properties.AttributeMappings == [
    {CertificateField: 'x509Issuer', MappingRules: [{Specifier: 'CN'}]},
    {CertificateField: 'x509Subject', MappingRules: [{Specifier: 'CN'}]}
  ]
  %restore_profile.Properties.AttributeMappings == [
    {CertificateField: 'x509Issuer', MappingRules: [{Specifier: 'CN'}]},
    {CertificateField: 'x509Subject', MappingRules: [{Specifier: 'CN'}]}
  ]
  %backup_session_statement_count == 3
  %restore_session_statement_count == 1
  %backup_session.Version == '2012-10-17'
  %restore_session.Version == '2012-10-17'
  %backup_session_inspect_count == 1
  %backup_session_inspect.Effect == 'Allow'
  %backup_session_inspect.Action == 's3:GetBucketVersioning'
  %backup_session_inspect.Resource == '${SonarBackupBucket.Arn}'
  %backup_session_list_action_count == 1
  %backup_session_list.Effect == 'Allow'
  %backup_session_list.Action == ['s3:ListBucket']
  %backup_session_object_action_count == 4
  %backup_session_objects.Effect == 'Allow'
  %backup_session_objects.Action == ['s3:DeleteObject', 's3:GetObject', 's3:GetObjectVersion', 's3:PutObject']
  %backup_session_objects.Resource == [
    '${SonarBackupBucket.Arn}/${SonarPrefix}/daily/*',
    '${SonarBackupBucket.Arn}/${SonarPrefix}/weekly/*'
  ]
  %restore_session_object_action_count == 1
  %restore_session_objects.Effect == 'Allow'
  %restore_session_objects.Action == ['s3:GetObjectVersion']
  %restore_session_objects.Resource == [
    '${SonarBackupBucket.Arn}/${SonarPrefix}/daily/*',
    '${SonarBackupBucket.Arn}/${SonarPrefix}/weekly/*'
  ]
}

