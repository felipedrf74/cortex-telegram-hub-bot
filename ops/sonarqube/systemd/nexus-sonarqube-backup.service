[Unit]
Description=Encrypted off-host SonarQube PostgreSQL backup
After=docker.service nexus-sonarqube.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/quality-sonar-backup --config /etc/sonarqube/backup.env
UMask=0077
Nice=10
IOSchedulingClass=idle
