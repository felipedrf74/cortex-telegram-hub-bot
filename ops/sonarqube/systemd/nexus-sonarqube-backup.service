[Unit]
Description=Local SonarQube PostgreSQL backup
After=docker.service
Requires=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/quality-sonar-backup --config /etc/nexus-sonarqube-backup.env
Restart=on-failure
RestartSec=15min
TimeoutStartSec=30min
TimeoutStopSec=2min
UMask=0077
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadOnlyPaths=/home/dominguez/sonarqube
ReadWritePaths=/srv/nexus-backups/sonarqube /run/lock/nexus-release-sonar.lock
