[Unit]
Description=Recover interrupted Nexus rollback-drill guest runtime installation
DefaultDependencies=no
After=local-fs.target
Before=cloud-final.service ssh.service multi-user.target
ConditionPathExists=/usr/local/sbin/nexus-rollback-drill-vm-runtime-control

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nexus-rollback-drill-vm-runtime-control recover-install
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=false
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
