[Unit]
Description=Recover interrupted Nexus release-layout fault drill
ConditionPathExists=/dev/kvm
ConditionPathExists=/var/lib/nexus-rollback-drill-vm/release-layout-fault-drills
ConditionPathExists=/var/lib/nexus-rollback-drill-vm/active.json
ConditionPathExists=/var/lib/nexus-rollback-drill-vm/release-layout-evidence-trust.v1.json
ConditionPathExists=/run/nexus-rollback-drill-vm/release-layout-fault-controller.lock
ConditionPathExists=!/var/lib/nexus-rollback-drill-vm/install-in-progress.v1
ConditionPathExists=!/var/lib/nexus-rollback-drill-vm/provision-in-progress.v1
Wants=dev-kvm.device
After=systemd-tmpfiles-setup.service dev-kvm.device
StartLimitIntervalSec=120s
StartLimitBurst=4

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/nexus-rollback-drill-vm/release-layout-fault-controller recover-all
UMask=0077
TimeoutStartSec=900s
KillMode=control-group
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateDevices=false
PrivateMounts=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=default
ProtectSystem=strict
ReadOnlyPaths=/etc/nexus-release /var/lib/nexus-rollback-drill-vm/active.json /var/lib/nexus-rollback-drill-vm/release-layout-evidence-trust.v1.json /var/lib/nexus-rollback-drill-vm/sets
ReadWritePaths=/var/lib/nexus-rollback-drill-vm/release-layout-fault-drills /run
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_KILL
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
