# Install as /etc/nexus-local-backup/backup.env, root:root, mode 0600.
# Post-cutover production database. PM2 first-cutover fallback only used the
# legacy ~/telegram-hub-bot/data/bot.db path (the deploy user home).
NEXUS_LOCAL_BACKUP_DATABASE_PATH=/var/lib/nexus-hub/production/data/bot.db
NEXUS_LOCAL_BACKUP_ROOT=/srv/nexus-backups/application
NEXUS_LOCAL_BACKUP_AGE_RECIPIENT=age1replace-with-the-public-recipient
NEXUS_LOCAL_BACKUP_AGE_IDENTITY=/etc/nexus-local-backup/age-identity.txt
