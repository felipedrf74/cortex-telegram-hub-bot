[Unit]
Description=Nexus Hub encrypted local SQLite backup
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/nexus-release/poller.env
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT LD_DEBUG LD_PROFILE BASH_ENV ENV SHELLOPTS BASHOPTS PS4 NODE_OPTIONS NODE_PATH NEXUS_RELEASE_AUDIT_MIRROR_HOST
RuntimeDirectory=nexus-local-backup-active
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin /usr/local/libexec/nexus-local-backup/local-backup-retry-launcher.sh backup
ExecStopPost=/opt/nexus-release/checkout/scripts/release-operational-alert-launcher.sh --unit=nexus-local-backup.service
StateDirectory=nexus-release/operational-alerts
StateDirectoryMode=0700
UMask=0077
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
# SQLite may create WAL coordination sidecars even for a read-only source. The
# producer inode-binds them and normalizes only safe root-created sidecars to
# the database owner before copying; confine that write capability here.
# The optional (-) legacy entry is a neutral default; deployments using the
# legacy home layout must override that path with a systemd drop-in.
ReadWritePaths=/srv/nexus-backups/application /var/lib/nexus-release/operational-alerts -/var/lib/nexus-hub/legacy/telegram-hub-bot/data -/var/lib/nexus-hub/production/data
TimeoutStartSec=67min
TimeoutStopSec=3min
Restart=no
