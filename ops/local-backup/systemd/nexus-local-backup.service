[Unit]
Description=Nexus Hub encrypted local SQLite backup

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/nexus-local-backup/local-backup.py backup
UMask=0077
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
# SQLite may create WAL coordination sidecars even for a read-only source. The
# producer inode-binds them and normalizes only safe root-created sidecars to
# the database owner before copying; confine that write capability here.
ReadWritePaths=/srv/nexus-backups/application -/home/dominguez/telegram-hub-bot/data -/var/lib/nexus-hub/production/data
TimeoutStartSec=12min
