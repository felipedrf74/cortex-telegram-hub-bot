[Unit]
Description=Nexus Hub encrypted local SQLite backup

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/nexus-local-backup/local-backup.py backup
UMask=0077
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/srv/nexus-backups/application
TimeoutStartSec=12min
