[Unit]
Description=Nexus Hub encrypted pre-promotion SQLite backup

[Service]
Type=oneshot
User=root
Group=root
RuntimeDirectory=nexus-local-backup-pre-promotion-active
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin /usr/local/libexec/nexus-local-backup/local-backup.py pre-promotion
UMask=0077
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
# SQLite may create WAL coordination sidecars even for a read-only source. The
# producer inode-binds them and normalizes only safe root-created sidecars to
# the database owner before copying; confine that write capability here.
# The optional (-) legacy entry is a neutral default; deployments using the
# legacy home layout must override that path with a systemd drop-in.
ReadWritePaths=/srv/nexus-backups/application -/var/lib/nexus-hub/legacy/telegram-hub-bot/data -/var/lib/nexus-hub/production/data
TimeoutStartSec=18min
