[Unit]
Description=Nexus Hub encrypted pre-promotion SQLite backup

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/nexus-local-backup/local-backup.py pre-promotion
UMask=0077
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/srv/nexus-backups/application
TimeoutStartSec=30min
