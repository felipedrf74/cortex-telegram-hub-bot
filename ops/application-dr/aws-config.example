# Install as /etc/nexus-application-dr/aws-config, root:root, mode 0600.
# Replace every placeholder and keep the selected profile dedicated to the
# prefix-scoped application DR writer role. The private-key/PIN custody design
# remains an owner-approved operational gate; do not place key material here.
[profile nexus-application-dr-backup]
region = eu-west-1
credential_process = /usr/local/libexec/nexus-application-dr/aws_signing_helper credential-process --certificate /etc/nexus-application-dr/roles-anywhere-certificate.pem --private-key /etc/nexus-application-dr/roles-anywhere-private-key.pem --trust-anchor-arn arn:aws:rolesanywhere:eu-west-1:111122223333:trust-anchor/replace-with-trust-anchor-id --profile-arn arn:aws:rolesanywhere:eu-west-1:111122223333:profile/replace-with-profile-id --role-arn arn:aws:iam::111122223333:role/nexus-application-dr-backup

[profile nexus-application-dr-restore]
region = eu-west-1
credential_process = /usr/local/libexec/nexus-application-dr/aws_signing_helper credential-process --certificate /etc/nexus-application-dr/roles-anywhere-restore-certificate.pem --private-key /etc/nexus-application-dr/roles-anywhere-restore-private-key.pem --trust-anchor-arn arn:aws:rolesanywhere:eu-west-1:111122223333:trust-anchor/replace-with-trust-anchor-id --profile-arn arn:aws:rolesanywhere:eu-west-1:111122223333:profile/replace-with-restore-profile-id --role-arn arn:aws:iam::111122223333:role/nexus-application-dr-restore
