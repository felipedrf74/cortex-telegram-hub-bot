# Install as /etc/nexus-application-dr/aws-config, root:root, mode 0600.
# Replace every placeholder and keep the selected profile dedicated to the
# prefix-scoped application DR writer role. The private-key/PIN custody design
# remains an owner-approved operational gate; do not place key material here.
# Use only the exact role, trust-anchor, and profile ARNs emitted by the reviewed
# aws-s3-stack.yaml managed-mode change set. Backup and restore must use
# different leaf certificates and private keys whose CNs match the stack inputs.
# The deliberately non-ARN REPLACE_WITH_STACK_OUTPUT_* values must be replaced
# verbatim from the named CloudFormation outputs; never infer generated names.
[profile nexus-application-dr-backup]
region = eu-west-1
credential_process = /usr/local/libexec/nexus-application-dr/aws_signing_helper credential-process --certificate /etc/nexus-application-dr/roles-anywhere-certificate.pem --private-key /etc/nexus-application-dr/roles-anywhere-private-key.pem --trust-anchor-arn REPLACE_WITH_STACK_OUTPUT_RolesAnywhereTrustAnchorArn --profile-arn REPLACE_WITH_STACK_OUTPUT_BackupRolesAnywhereProfileArn --role-arn REPLACE_WITH_STACK_OUTPUT_BackupPrincipalArn --session-duration 900

[profile nexus-application-dr-restore]
region = eu-west-1
credential_process = /usr/local/libexec/nexus-application-dr/aws_signing_helper credential-process --certificate /etc/nexus-application-dr/roles-anywhere-restore-certificate.pem --private-key /etc/nexus-application-dr/roles-anywhere-restore-private-key.pem --trust-anchor-arn REPLACE_WITH_STACK_OUTPUT_RolesAnywhereTrustAnchorArn --profile-arn REPLACE_WITH_STACK_OUTPUT_RestoreRolesAnywhereProfileArn --role-arn REPLACE_WITH_STACK_OUTPUT_RestorePrincipalArn --session-duration 900
