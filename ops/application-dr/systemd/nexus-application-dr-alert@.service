[Unit]
Description=Persist local Nexus application DR alert for %i

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/nexus-application-dr/application-dr-alert.py --unit %i --state-dir /var/lib/nexus-application-dr --systemctl /usr/bin/systemctl --logger /usr/bin/logger
UMask=0077
StateDirectory=nexus-application-dr
StateDirectoryMode=0700
TimeoutStartSec=30s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nexus-application-dr
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
