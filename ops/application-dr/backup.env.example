# Install as /etc/nexus-application-dr/backup.env, root:root, mode 0600.
# Prefer an instance role or credential_process. Values below are placeholders,
# not credentials. The age recipient is public; keep its private identity off
# ServerDominguez and provide it only to an isolated quarterly drill host.
AWS_ACCESS_KEY_ID=replace-with-prefix-scoped-writer
AWS_SECRET_ACCESS_KEY=replace-with-prefix-scoped-secret
AWS_REGION=eu-west-1

NEXUS_DR_S3_ENDPOINT=https://s3-compatible.example.invalid
NEXUS_DR_S3_BUCKET=replace-me
NEXUS_DR_S3_PREFIX=nexus-hub/application
# Default: versioned S3. For an owner-approved Cloudflare R2 variance, use:
#   NEXUS_DR_STORAGE_PROVIDER=cloudflare-r2
#   NEXUS_DR_STORAGE_CONTROL_MODE=r2-approved-variance
# and provide current release-prefix bucket-lock evidence in the private JSON
# file below. OPERATIONS.txt defines both exact evidence shapes.
NEXUS_DR_STORAGE_PROVIDER=aws-s3
NEXUS_DR_STORAGE_CONTROL_MODE=versioned-s3
NEXUS_DR_STORAGE_CONTROL_EVIDENCE=/etc/nexus-application-dr/storage-control-evidence.json
NEXUS_DR_AGE_RECIPIENT=age1replacewithanoffhostpublicrecipient000000000000000000000

NEXUS_DR_APPLICATION_USER=dominguez
NEXUS_DR_DATABASE_PATH=/srv/nexus-release/production/data/bot.db
NEXUS_DR_ROLLBACK_DIR=/home/dominguez/backups/nexushub
NEXUS_DR_STATE_DIR=/var/lib/nexus-application-dr
NEXUS_DR_PYTHON_BIN=/usr/bin/python3.12
NEXUS_DR_NODE_BIN=/usr/bin/node
NEXUS_DR_RELEASE_PUBLIC_KEY=/etc/nexus-application-dr/release-evidence-public-key.pem

# The quarterly drill runs the repository's root-owned, fail-closed isolated
# harness as a dedicated nologin user. Node/Python must be the exact root-owned
# runtime versions bound by the release dependency lock.
NEXUS_DR_RESTORE_HARNESS=/usr/local/libexec/nexus-application-dr/application-dr-isolated-harness.sh
NEXUS_DR_DRILL_BASE_URL=http://127.0.0.1:19080
NEXUS_DR_DRILL_USER=nexus-drill
NEXUS_DR_DRILL_NODE_BIN=/usr/bin/node
