# /etc/nexus-release/poller.env — root:root, mode 0600.
#
# Operator-supplied values for the release poller. Nothing here is committed and
# nothing here reaches a receipt or a notification body.
#
# Install with:
#   sudo install -o root -g root -m 600 poller.env.example /etc/nexus-release/poller.env
# then edit in place.

# Host of the separate root-owned Pi audit account that receipts are mirrored to.
# Leave unset to disable mirroring; mirroring is never a release gate either way.
NEXUS_RELEASE_AUDIT_MIRROR_HOST=

# Telegram credentials for release failure, recovery, and heartbeat messages.
# A dedicated bot and chat, not the product bot: release alerts must not depend
# on, or be able to reach, user conversations.
NEXUS_RELEASE_TELEGRAM_BOT_TOKEN=
NEXUS_RELEASE_TELEGRAM_CHAT_ID=

# These are the only three names an installed unit forwards. Every command runs
# through env -i; arbitrary/stale DOCKER_*, COMPOSE_*, NODE_OPTIONS, LD_*, GIT_*,
# command, or lock-path entries in this file are discarded before any release
# child starts. Lock paths come only from config/continuous-deployment.json.
