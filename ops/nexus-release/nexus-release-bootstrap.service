[Unit]
Description=Nexus Hub owner-authorized first container bootstrap
Documentation=file:///opt/nexus-release/checkout/ops/nexus-release/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=!/var/lib/nexus-release/state/control-plane-transaction.json
ConditionPathIsSymbolicLink=!/var/lib/nexus-release/state/control-plane-transaction.json
ConditionPathExists=!/var/lib/nexus-release/state/control-plane-post-gate.json
ConditionPathIsSymbolicLink=!/var/lib/nexus-release/state/control-plane-post-gate.json
ConditionPathExists=!/var/lib/nexus-release/state/pm2-fallback-retirement.json
ConditionPathIsSymbolicLink=!/var/lib/nexus-release/state/pm2-fallback-retirement.json
ConditionPathExists=!/var/lib/nexus-release/state/pm2-fallback-retired.json
ConditionPathIsSymbolicLink=!/var/lib/nexus-release/state/pm2-fallback-retired.json
ConditionPathExists=/var/lib/nexus-release/state/bootstrap-baseline.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/nexus-release/checkout

# Load the three declared operator values. Every executable below starts through
# env -i and forwards only those values explicitly; arbitrary or stale keys in
# this file never reach Node, Bash, Git, Docker, Compose, or their children.
EnvironmentFile=-/etc/nexus-release/poller.env
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT LD_DEBUG LD_PROFILE

# Refuse a partial/mutable host installation before this one-shot gains the only
# first-container bootstrap authority. Match the ordinary poller's native proof.
ExecStartPre=/usr/bin/env -i PATH=/usr/bin:/bin /usr/bin/test -f /opt/nexus-release/checkout/.nexus-control-plane-ready
ExecStartPre=/usr/bin/env -i PATH=/usr/bin:/bin HOME=/var/lib/nexus-release/home /usr/bin/node -e "if (process.version !== 'v22.23.1') process.exit(1)"
ExecStartPre=/usr/bin/env -i PATH=/usr/bin:/bin HOME=/var/lib/nexus-release/home /usr/bin/node -e "const Database=require('/opt/nexus-release/checkout/node_modules/better-sqlite3');const db=new Database(':memory:');db.close()"

# This is the only installed entry point carrying the one-shot bootstrap flag.
# The ordinary poller service and timer never carry it. The deployment code also
# requires state.predecessor to be absent and re-verifies the fresh exact database
# baseline before staging, so starting this unit after cutover grants nothing.
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin HOME=/var/lib/nexus-release/home DOCKER_CONFIG=/etc/nexus-release/docker NEXUS_RELEASE_AUDIT_MIRROR_HOST=${NEXUS_RELEASE_AUDIT_MIRROR_HOST} NEXUS_RELEASE_TELEGRAM_BOT_TOKEN=${NEXUS_RELEASE_TELEGRAM_BOT_TOKEN} NEXUS_RELEASE_TELEGRAM_CHAT_ID=${NEXUS_RELEASE_TELEGRAM_CHAT_ID} NEXUS_RELEASE_NODE_BIN=/usr/bin/node NEXUS_RELEASE_GIT_BIN=/usr/bin/git NEXUS_RELEASE_FLOCK_BIN=/usr/bin/flock NEXUS_RELEASE_SYSTEMCTL_BIN=/usr/bin/systemctl NEXUS_RELEASE_DOCKER_BIN=/usr/bin/docker NEXUS_RELEASE_SQLITE_BIN=/usr/bin/sqlite3 NEXUS_RELEASE_LSOF_BIN=/usr/bin/lsof NEXUS_RELEASE_SCP_BIN=/usr/bin/scp NEXUS_RELEASE_SSH_BIN=/usr/bin/ssh /opt/nexus-release/checkout/scripts/release-poll.sh --allow-first-container-bootstrap
# There is no safe finite outer sum for registry discovery, baseline reads, and
# individually bounded phases. Their inner deadlines remain authoritative;
# systemd must never kill the only no-predecessor cutover during mutation.
TimeoutStartSec=infinity
NoNewPrivileges=yes
# Hide every home directory, then expose only the two stopped legacy SQLite
# directories read-only. Bootstrap re-hashes those exact source snapshots and
# runs lsof against them; ordinary release code never needs home visibility.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/dominguez/telegram-hub-bot/data /home/dominguez/telegram-hub-bot-staging/data
ProtectSystem=full
ReadOnlyPaths=/opt/nexus-release
ReadWritePaths=/var/lib/nexus-release /var/lib/nexus-hub /srv/nexus-backups
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexus-release-bootstrap
