#!/usr/bin/env bash
# ─────────────────────────────────────────────────────
# Committed pre-commit hook (release-pipeline-risk-based-optimization,
# 2026-05-03; supersedes 2026-04-20 hardening pass).
#
# Activate once per clone:
#   git config core.hooksPath .husky
#
# Behavior:
#   - typecheck: ALWAYS (`npx tsc --noEmit`). Types are global; cheap (~5–8 s).
#   - vitest: gated by the changed-area classifier
#       * docs-only diff           → skip vitest entirely (saves ~9 min)
#       * source/test diff         → focused `vitest run` against domain-scoped
#                                    globs from the classifier
#       * test config / package*   → full `vitest run` (shared-behavior risk)
#       * unmapped non-doc diff    → `vitest run --changed origin/main`
#         (changed-files-only)
#
#   - escape hatch: NEXUS_PRECOMMIT_FULL_VITEST=1 forces the legacy
#     full-suite behavior (used when investigating a flake or running
#     a release-candidate commit).
#   - failure-safe: if the classifier or git base resolution fails, the
#     hook falls back to the legacy full-vitest run.
# ─────────────────────────────────────────────────────
set -e

ROOT="$(git rev-parse --show-toplevel)"
CLASSIFIER="$ROOT/scripts/changed-area-classifier.sh"

echo "🔍 Pre-commit: Type checking..."
npx tsc --noEmit
echo "✅ Type check passed"

# ── Science-policy version gate (R4 P2 fix) ──────────
# When training-principles.json or its pin file is in the staged diff,
# verify the content hash matches the pinned sciencePolicyVersion.
# Codex caught (R4 P2) that the gate script existed but no commit
# pathway invoked it — making the "every plan stamped with a stable
# policy version" invariant only enforced by reading docs. This gate
# is millisecond-cheap when nothing relevant is staged, so we only
# skip when the file isn't touched. Disable via
# NEXUS_PRECOMMIT_SKIP_SCIENCE_POLICY=1.
SCIENCE_POLICY_TOUCHED="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^src/services/coach-kernel/knowledge/entities/(training-principles\.json|\.science-policy-hash)$' || true)"
if [ "${NEXUS_PRECOMMIT_SKIP_SCIENCE_POLICY:-0}" != "1" ] && [ -n "$SCIENCE_POLICY_TOUCHED" ]; then
  echo "🧪 Pre-commit: training-principles changed — running science-policy version check"
  node "$ROOT/scripts/ci/science-policy-version-check.mjs"
  echo "✅ Science-policy version pin OK"
fi

# ── Release-identity auto-refresh (release-pipeline-risk-based-
# optimization, 2026-05-03):
# If any current-verdict doc is staged, regenerate the persisted
# release-identity artifact so the doc's references are always backed
# by the latest git state. Auto-stages the refreshed artifact so the
# identity update lands in the same commit.
# Disable with NEXUS_PRECOMMIT_SKIP_IDENTITY_REFRESH=1.
STAGED_FILES_FOR_IDENTITY="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
if [ "${NEXUS_PRECOMMIT_SKIP_IDENTITY_REFRESH:-0}" != "1" ] && \
   echo "$STAGED_FILES_FOR_IDENTITY" \
   | grep -E '(^|/)(docs/release/CURRENT_RELEASE_STATE\.md|docs/release/OPEN_ITEMS\.md|docs/release/release-pipeline-optimization-report\.md|docs/release/current-release-index\.md|docs/qa/QA_BACKEND_REPORT\.md|docs/qa/QA_IOS_REPORT\.md)$' \
   >/dev/null 2>&1; then
  echo "📝 Pre-commit: refreshing release-identity artifact (current-verdict doc staged)"
  if [ -x "$ROOT/scripts/release-identity.sh" ]; then
    "$ROOT/scripts/release-identity.sh" --persist --quiet \
      || echo "    ⚠️ release-identity refresh failed (non-fatal)"
    # Auto-stage the refreshed artifact only if it's a tracked file.
    WORKSPACE_DOCS_ROOT="${NEXUS_WORKSPACE_DOCS_ROOT:-/Users/felipedominguez/Desktop/Nexus Hub}"
    for ART in \
      "$WORKSPACE_DOCS_ROOT/docs/release/release-identity.json" \
      "$WORKSPACE_DOCS_ROOT/docs/release/release-identity.md"; do
      if [ -f "$ART" ] && git -C "$ROOT" ls-files --error-unmatch "$ART" >/dev/null 2>&1; then
        git -C "$ROOT" add "$ART" 2>/dev/null || true
      fi
    done
  fi
fi

# ── Vitest gating ─────────────────────────────────────
if [ "${NEXUS_PRECOMMIT_FULL_VITEST:-0}" = "1" ]; then
  echo "🧪 Pre-commit: NEXUS_PRECOMMIT_FULL_VITEST=1 — running full vitest suite..."
  npx vitest run --reporter=dot
  echo "✅ Tests passed (full)"
  exit 0
fi

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR | tr '\n' ',' | sed 's/,$//')"

if [ -z "$STAGED_FILES" ]; then
  echo "🧪 Pre-commit: nothing staged — skipping vitest"
  exit 0
fi

if [ ! -x "$CLASSIFIER" ]; then
  echo "⚠️  Classifier not found at $CLASSIFIER — falling back to full vitest"
  npx vitest run --reporter=dot
  echo "✅ Tests passed (full, classifier unavailable)"
  exit 0
fi

CLASSIFIER_JSON="$("$CLASSIFIER" --files "$STAGED_FILES" --format json 2>/dev/null || true)"
if [ -z "$CLASSIFIER_JSON" ]; then
  echo "⚠️  Classifier produced no output — falling back to full vitest"
  npx vitest run --reporter=dot
  echo "✅ Tests passed (full, classifier no-op)"
  exit 0
fi

# Use a small node helper to extract mode + globs + skipReason. Errors fall
# back to mode=full so we never silently skip a real risk.
VITEST_MODE="$(printf '%s' "$CLASSIFIER_JSON" | node -e '
  let b = "";
  process.stdin.on("data", (c) => (b += c));
  process.stdin.on("end", () => {
    try {
      const j = JSON.parse(b);
      process.stdout.write(j.vitest.mode || "full");
    } catch (_) {
      process.stdout.write("full");
    }
  });
' 2>/dev/null || echo "full")"

read_globs() {
  printf '%s' "$CLASSIFIER_JSON" | node -e '
    let b = "";
    process.stdin.on("data", (c) => (b += c));
    process.stdin.on("end", () => {
      try {
        const g = JSON.parse(b).vitest.globs || [];
        process.stdout.write(g.join(" "));
      } catch (_) {}
    });
  ' 2>/dev/null
}

read_skip_reason() {
  printf '%s' "$CLASSIFIER_JSON" | node -e '
    let b = "";
    process.stdin.on("data", (c) => (b += c));
    process.stdin.on("end", () => {
      try {
        process.stdout.write(JSON.parse(b).vitest.skipReason || "");
      } catch (_) {}
    });
  ' 2>/dev/null
}

case "$VITEST_MODE" in
  skip)
    REASON="$(read_skip_reason)"
    echo "🧪 Pre-commit: docs-only/non-vitest staged set — skipping vitest"
    [ -n "$REASON" ] && echo "    classifier reason: $REASON"
    exit 0
    ;;
  full)
    echo "🧪 Pre-commit: shared-behavior risk — running full vitest suite..."
    npx vitest run --reporter=dot
    echo "✅ Tests passed (full)"
    ;;
  changed-only)
    BASE_REF="$(git for-each-ref --format='%(refname:short)' refs/remotes/origin/main 2>/dev/null | head -1)"
    BASE_REF="${BASE_REF:-main}"
    echo "🧪 Pre-commit: scoped — running vitest --changed $BASE_REF..."
    npx vitest run --reporter=dot --changed "$BASE_REF"
    echo "✅ Tests passed (changed-only)"
    ;;
  focused)
    GLOBS="$(read_globs)"
    if [ -z "$GLOBS" ]; then
      echo "⚠️  Focused mode but no globs — falling back to full vitest"
      npx vitest run --reporter=dot
      echo "✅ Tests passed (full, focused fallback)"
    else
      FILTERED_GLOBS="$(node "$ROOT/scripts/filter-existing-vitest-globs.mjs" $GLOBS 2>/dev/null || true)"
      if [ -z "$FILTERED_GLOBS" ]; then
        echo "⚠️  Focused globs matched no test files — falling back to full vitest"
        npx vitest run --reporter=dot
        echo "✅ Tests passed (full, no matching focused globs)"
        exit 0
      fi
      if [ "$FILTERED_GLOBS" != "$GLOBS" ]; then
        echo "⚠️  Pre-commit: dropped focused globs with no matching test files"
      fi
      echo "🧪 Pre-commit: focused — running vitest against domain-scoped globs"
      printf '    %s\n' $FILTERED_GLOBS
      # shellcheck disable=SC2086
      npx vitest run --reporter=dot $FILTERED_GLOBS
      echo "✅ Tests passed (focused)"
    fi
    ;;
  *)
    echo "⚠️  Unknown vitest mode '$VITEST_MODE' — falling back to full vitest"
    npx vitest run --reporter=dot
    echo "✅ Tests passed (full, unknown mode fallback)"
    ;;
esac

# ── Local Docker sandbox nudge (soft, non-blocking) ────────────────
# Print a friendly warning if the local-dev sandbox isn't running.
# This is intentionally not a gate — staging+prod still have their own
# smoke gates. Goal: remind Felipe to ./scripts/local-smoke.sh before
# pushing. Disable with NEXUS_PRECOMMIT_SKIP_SANDBOX_NUDGE=1.
if [ "${NEXUS_PRECOMMIT_SKIP_SANDBOX_NUDGE:-0}" != "1" ] \
   && [ -f "$ROOT/docker-compose.local.yml" ]; then
  if ! docker compose -f "$ROOT/docker-compose.local.yml" ps --status running --quiet 2>/dev/null | grep -q .; then
    echo "💡 Local sandbox isn't running. Before pushing, consider:"
    echo "     ./scripts/local-up.sh && ./scripts/local-smoke.sh"
    echo "   (Soft nudge only — this hook does not block.)"
  fi
fi
