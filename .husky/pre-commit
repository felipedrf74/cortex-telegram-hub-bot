#!/usr/bin/env bash
set -euo pipefail

while IFS= read -r git_environment_name; do
  unset "$git_environment_name"
done < <(compgen -e | LC_ALL=C sort | grep '^GIT_' || true)
export GIT_NO_REPLACE_OBJECTS=1

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "🔍 Pre-commit risk gate"

# Watch training-principles.json and .science-policy-hash together.
SCIENCE_POLICY_TOUCHED="$(git diff --cached --name-only --diff-filter=ACMRTD --no-renames | grep -E '^src/services/coach-kernel/knowledge/entities/(training-principles\.json|\.science-policy-hash)$' || true)"
if [ "${NEXUS_PRECOMMIT_SKIP_SCIENCE_POLICY:-0}" != "1" ] && [ -n "$SCIENCE_POLICY_TOUCHED" ]; then
  echo "🧪 training-principles changed — running science-policy version check"
  node "$ROOT/scripts/ci/science-policy-version-check.mjs"
fi

STAGED_FILES_FOR_IDENTITY="$(git diff --cached --name-only --diff-filter=ACMRTD --no-renames 2>/dev/null || true)"
if [ "${NEXUS_PRECOMMIT_SKIP_IDENTITY_REFRESH:-0}" != "1" ] && \
   echo "$STAGED_FILES_FOR_IDENTITY" \
   | grep -E '(^|/)(docs/release/CURRENT_RELEASE_STATE\.md|docs/release/OPEN_ITEMS\.md|docs/release/release-pipeline-optimization-report\.md|docs/release/current-release-index\.md|docs/qa/QA_BACKEND_REPORT\.md|docs/qa/QA_IOS_REPORT\.md)$' \
   >/dev/null 2>&1; then
  echo "📝 refreshing release-identity artifact"
  if [ -x "$ROOT/scripts/release-identity.sh" ]; then
    "$ROOT/scripts/release-identity.sh" --persist --quiet || echo "⚠️ release-identity refresh failed (non-fatal)"
    WORKSPACE_DOCS_ROOT="${NEXUS_WORKSPACE_DOCS_ROOT:-/Users/felipedominguez/Desktop/Nexus Hub}"
    for ART in \
      "$WORKSPACE_DOCS_ROOT/docs/release/release-identity.json" \
      "$WORKSPACE_DOCS_ROOT/docs/release/release-identity.md"; do
      if [ -f "$ART" ] && git -C "$ROOT" ls-files --error-unmatch "$ART" >/dev/null 2>&1; then
        git -C "$ROOT" add "$ART" 2>/dev/null || true
      fi
    done
  fi
fi

if git diff --cached --quiet --exit-code; then
  echo "🧪 nothing staged — skipping risk gate"
  exit 0
fi

scripts/risk-gate.sh --staged

if [ "${NEXUS_PRECOMMIT_SKIP_SANDBOX_NUDGE:-0}" != "1" ] \
   && [ -f "$ROOT/docker-compose.local.yml" ]; then
  if ! docker compose -f "$ROOT/docker-compose.local.yml" ps --status running --quiet 2>/dev/null | grep -q .; then
    echo "💡 Local sandbox is not running. Consider ./scripts/local-up.sh && ./scripts/local-smoke.sh before pushing."
  fi
fi
