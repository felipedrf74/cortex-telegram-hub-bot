# Nexus Hub — Content Engine (Python FastAPI)
#
# Single-stage slim image. Mounted source via docker-compose.local.yml
# gives hot reload (uvicorn --reload). The image only carries:
#   - python3.12 + pip
#   - curl for the compose healthcheck
#   - the pinned requirements from content-engine/requirements.txt

FROM python:3.12-slim
WORKDIR /engine

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

COPY content-engine/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Source is copied for the initial build; the compose bind mount over
# /engine takes precedence at runtime so edits hot-reload.
COPY content-engine/ ./

ENV PYTHONUNBUFFERED=1
ENV CONTENT_ENGINE_PORT=8100

EXPOSE 8100

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 \
  CMD curl -fsS http://127.0.0.1:8100/health || exit 1

# 0.0.0.0 is required so the Node container on the same compose network
# can reach this service. main.py defaults to 127.0.0.1 which would only
# answer from inside this container.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8100", "--reload"]
