{
  "name": "@nexushub/core",
  "version": "4.14.117",
  "description": "Nexus Hub — AI-powered creator operating system with multi-domain routing",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/portal/portal.html dist/portal/portal.html && cp src/portal/landing.html dist/portal/landing.html && rm -rf dist/services/coach-kernel/knowledge && mkdir -p dist/services/coach-kernel/knowledge && cp -R src/services/coach-kernel/knowledge/* dist/services/coach-kernel/knowledge/",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "eval:training": "npm run build && node dist/tools/training-eval-harness.js",
    "eval:content": "npm run build && node dist/tools/content-evaluation-harness.js",
    "smoke:content:local": "scripts/content-full-nexus-local-smoke.sh",
    "smoke:cooking:portal": "npx tsx scripts/cooking-portal-browser-smoke.ts",
    "smoke:training-calendar:staging": "npm run build && node dist/tools/training-calendar-staging-smoke.js",
    "smoke:training-cross-skill:staging": "npm run build && node dist/tools/training-cross-skill-staging-smoke.js",
    "typecheck": "tsc --noEmit",
    "preflight:owner-bootstrap": "node dist/tools/owner-bootstrap-preflight.js --strict",
    "portal:session:mint": "node dist/tools/portal-session-token.js",
    "chat:eval": "node dist/tools/chat-evaluation-harness.js",
    "fiscal:vendors:audit": "node dist/tools/invoice-vendor-cleanup.js",
    "fiscal:vendors:repair": "node dist/tools/invoice-vendor-cleanup.js --apply",
    "lint": "npm run typecheck",
    "verify": "npm run typecheck && npm run test",
    "precommit": "npm run verify",
    "release:patch": "npm run verify && npm version patch",
    "release:minor": "npm run verify && npm version minor",
    "release:major": "npm run verify && npm version major"
  },
  "keywords": [
    "telegram",
    "bot",
    "ai",
    "claude",
    "productivity",
    "content-creation"
  ],
  "author": "Felipe Dominguez",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <26",
    "npm": ">=10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@azure/msal-node": "^5.0.6",
    "@google/generative-ai": "^0.24.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@sentry/node": "^10.47.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "cron-parser": "^5.5.0",
    "docx": "^9.6.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "garmin-connect": "^1.6.2",
    "googleapis": "^171.4.0",
    "grammy": "^1.41.1",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mammoth": "^1.12.0",
    "node-cron": "^4.2.1",
    "openai": "^6.33.0",
    "pino": "^10.3.1",
    "playwright": "^1.58.2",
    "resend": "^6.10.0",
    "sharp": "^0.34.5",
    "stripe": "^22.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.3.3",
    "@types/sharp": "^0.31.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.1.1",
    "@vitest/ui": "^3.1.1",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  }
}
