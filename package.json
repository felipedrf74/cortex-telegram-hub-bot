{
  "name": "@nexushub/core",
  "version": "4.4.6",
  "description": "Nexus Hub — AI-powered creator operating system with multi-domain routing",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/portal/portal.html dist/portal/portal.html",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "verify": "npm run typecheck && npm run test",
    "precommit": "npm run verify",
    "release:patch": "npm run verify && npm version patch",
    "release:minor": "npm run verify && npm version minor",
    "release:major": "npm run verify && npm version major"
  },
  "keywords": [
    "telegram",
    "bot",
    "ai",
    "claude",
    "productivity",
    "content-creation"
  ],
  "author": "Felipe Dominguez",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@azure/msal-node": "^5.0.6",
    "@google/generative-ai": "^0.24.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "better-sqlite3": "^12.6.2",
    "cron-parser": "^5.5.0",
    "docx": "^9.6.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "garmin-connect": "^1.6.2",
    "googleapis": "^171.4.0",
    "grammy": "^1.41.1",
    "luxon": "^3.7.2",
    "mammoth": "^1.12.0",
    "node-cron": "^4.2.1",
    "openai": "^6.33.0",
    "pino": "^10.3.1",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.3.3",
    "@types/sharp": "^0.31.1",
    "@vitest/coverage-v8": "^3.1.1",
    "@vitest/ui": "^3.1.1",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  }
}
