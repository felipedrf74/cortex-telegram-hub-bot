{
  "version": "2026-07-15",
  "defaultTier": "full",
  "releaseEvidence": {
    "minimumTestCounts": {
      "vitest": 9000,
      "pytest": 6
    },
    "basis": "Protected-main floors preserve the existing 10000/7 release baselines with the governed 10 percent tolerance while allowing intentional test consolidation."
  },
  "tiers": {
    "fast": {
      "description": "Deterministic unit, schema, policy, and release-tooling checks.",
      "targetSeconds": 90,
      "include": [
        "__tests__/utils/**/*.test.ts",
        "__tests__/types/**/*.test.ts",
        "__tests__/scripts/*.test.ts",
        "__tests__/services/*policy*.test.ts",
        "__tests__/services/*validation*.test.ts"
      ]
    },
    "critical": {
      "description": "Release-blocking security, migration, billing, routing, public contract, and rollback regressions.",
      "targetSeconds": 240,
      "include": [
        "__tests__/security/**/*.test.ts",
        "__tests__/scope/**/*.test.ts",
        "__tests__/api/auth-*.test.ts",
        "__tests__/api/*tenant*.test.ts",
        "__tests__/api/billing*.test.ts",
        "__tests__/migrations/**/*.test.ts",
        "__tests__/services/provider-fallback*.test.ts",
        "__tests__/services/cost-guardrail*.test.ts",
        "__tests__/scripts/release-*.test.ts",
        "__tests__/scripts/promote-*.test.ts",
        "__tests__/scripts/rollback-*.test.ts",
        "__tests__/scripts/deploy-*.test.ts",
        "__tests__/scripts/changed-area-classifier.test.ts",
        "__tests__/scripts/ci-required-test-sharding.test.ts",
        "__tests__/scripts/runtime-manifests.test.ts",
        "__tests__/services/capability-manifest-consolidation.test.ts",
        "__tests__/services/event-backbone.test.ts",
        "__tests__/services/product-learning.test.ts",
        "__tests__/services/training-exercise-media*.test.ts"
      ]
    },
    "evaluate": {
      "description": "Subjective quality, persona, provider, and long-running evaluation corpora.",
      "include": [
        "__tests__/**/*evaluation*.test.ts",
        "__tests__/**/*eval*.test.ts",
        "__tests__/personas/**/*.test.ts"
      ]
    }
  },
  "fullSuiteTriggers": [
    ".github/workflows/*.yml",
    ".github/actions/**",
    "vitest.config.ts",
    "__tests__/setup.ts",
    "__tests__/fixtures/**",
    "config/test-policy.json",
    "scripts/changed-area-classifier.sh",
    "scripts/resolve-ci-change-base.sh",
    "scripts/select-vitest-files.mjs",
    "scripts/run-test-tier.mjs",
    "scripts/risk-gate.sh",
    "scripts/lib/test-policy.mjs",
    "scripts/test-inventory.mjs",
    "scripts/test-migration-hook-lint.mjs",
    "scripts/changed-coverage-gate.mjs",
    "scripts/mutation-gate.mjs",
    "config/stryker.config.mjs",
    "src/services/database.ts",
    "package.json",
    "package-lock.json"
  ],
  "timingExceptions": [
    {
      "file": "__tests__/scripts/changed-area-classifier.test.ts",
      "owner": "release",
      "reason": "Creates isolated Git repositories and runs the complete cannot-skip dashboard; retained as release-infrastructure proof.",
      "expires": "2026-09-15"
    },
    {
      "file": "__tests__/services/paid-ai-cost-controls-migration-runner.test.ts",
      "owner": "database",
      "reason": "Retains one production-runner rehearsal with pre-226 historical edge rows and a second-pass idempotency proof; shared runners may exceed the global correctness timeout.",
      "expires": "2026-09-15"
    }
  ],
  "dispositionRules": [
    { "pattern": "__tests__/services/cross-agent-learning-qa-validation.test.ts", "disposition": "keep", "reason": "Duplicate happy paths and source-import assertions were removed; the remaining cases cover malformed signals, filtering boundaries, multi-agent consumption, and digest edge behavior absent from the primary suite." },
    { "pattern": "__tests__/services/skill-migration-qa-validation.test.ts", "disposition": "keep", "reason": "Retains skill schema, constraint, index, and cascade behavior while the redundant file-existence checks and empty-database full migration replay were deleted." },
    { "pattern": "__tests__/services/usage-metering.test.ts", "disposition": "keep", "reason": "Primary migrated-template suite consolidates the unique schema, aggregation, isolation, quota-boundary, and typed portal contracts; the duplicate QA and cross-module source-string assertions were removed." },
    { "pattern": "__tests__/**/*qa-validation.test.ts", "disposition": "keep", "reason": "Residual QA suites retain distinct boundary coverage after duplicate happy paths, source mirrors, and redundant migration setup were removed or consolidated into module-owned suites." },
    { "pattern": "__tests__/**/*source-contract.test.ts", "disposition": "convert", "reason": "Replace source-string assertions with typed, schema, AST, manifest, or generator checks." },
    { "pattern": "__tests__/**/*evaluation*.test.ts", "disposition": "eval", "reason": "Run subjective product-quality checks outside correctness CI." },
    { "pattern": "__tests__/**/*eval*.test.ts", "disposition": "eval", "reason": "Run subjective product-quality checks outside correctness CI." },
    { "pattern": "__tests__/**/*.test.ts", "disposition": "keep", "reason": "Retain until profiling and overlap evidence justify merge, conversion, evaluation, or deletion." }
  ],
  "coverage": {
    "global": { "lines": 78, "branches": 68, "functions": 84, "statements": 75 },
    "changed": { "lines": 80, "branches": 75 },
    "critical": { "lines": 90, "branches": 85 },
    "exceptions": [
      {
        "file": "src/services/database.ts",
        "owner": "test-infrastructure",
        "reason": "Legacy database facade baseline is 25.28% lines and 26.08% branches; the extracted migration runner is governed separately above 90/85 while facade coverage is ratcheted without blocking this delegation-only change.",
        "expires": "2026-08-31",
        "minimum": { "lines": 25, "branches": 26 }
      }
    ]
  },
  "mutation": {
    "schedule": "weekly",
    "scope": "changed-critical-modules",
    "thresholds": { "high": 80, "low": 70, "break": 70 },
    "criticalModulePatterns": [
      "src/api/*auth*.ts",
      "src/api/*tenant*.ts",
      "src/api/routes/auth*.ts",
      "src/api/routes/*billing*.ts",
      "src/api/routes/*tenant*.ts",
      "src/middleware/auth*.ts",
      "src/services/*auth*.ts",
      "src/services/*billing*.ts",
      "src/services/*tenant*.ts",
      "src/services/*provider*.ts",
      "src/services/database.ts",
      "src/services/migration-runner.ts",
      "src/services/cost-guardrail*.ts",
      "src/services/training-exercise-media*.ts"
    ],
    "cleanupMappings": [
      {
        "test": "__tests__/api/training-plan-generation-source-contract.test.ts",
        "replacementTests": ["__tests__/api/training-plan-generation.test.ts", "__tests__/api/training-routes.test.ts"],
        "sources": ["src/api/routes/training-plan-generation.ts", "src/api/routes/training-plan-routes.ts"],
        "reason": "Converted the source-substring contract into a quota-exhaustion token-zero route proof plus a recursive AST provider-boundary assertion."
      },
      {
        "test": "__tests__/brand/package-name.test.ts",
        "replacementTests": ["__tests__/brand/package-rename-qa-validation.test.ts"],
        "sources": ["package.json"],
        "reason": "Merged the duplicate package identity and license assertions into the retained brand contract suite."
      },
      {
        "test": "__tests__/brand/rename-qa-validation.test.ts",
        "replacementTests": ["__tests__/brand/package-rename-qa-validation.test.ts"],
        "sources": ["package.json", "src/portal/server.ts"],
        "reason": "Merged unique runtime-brand assertions into the retained package rename contract and removed repeated source scans."
      },
      {
        "test": "__tests__/portal/domain-status-qa-validation.test.ts",
        "replacementTests": ["__tests__/portal/domain-status.test.ts"],
        "sources": ["src/portal/snapshot-builder.ts", "src/portal/snapshot-statements.ts"],
        "reason": "Merged domain status behavior into the primary portal suite and removed brittle HTML and source substrings."
      },
      {
        "test": "__tests__/portal/health-endpoint-qa-validation.test.ts",
        "replacementTests": ["__tests__/portal/health-endpoints.test.ts"],
        "sources": ["src/portal/health-routes.ts", "src/portal/server.ts"],
        "reason": "Merged public health behavior and credential non-disclosure into the live HTTP contract suite."
      },
      {
        "test": "__tests__/portal/integration-health-qa-validation.test.ts",
        "replacementTests": ["__tests__/services/integration-health-observability.test.ts"],
        "sources": ["src/portal/snapshot-builder.ts", "src/services/integration-health.ts"],
        "reason": "Merged integration-health behavior into the typed observability suite and removed snapshot source mirrors."
      },
      {
        "test": "__tests__/portal/oauth-ios-callbacks-qa-validation.test.ts",
        "replacementTests": ["__tests__/portal/portal-oauth-routes.test.ts"],
        "sources": ["src/portal/oauth-routes.ts"],
        "reason": "Merged iOS callback response and redirect behavior into the primary OAuth route suite."
      },
      {
        "test": "__tests__/portal/skill-management-qa-validation.test.ts",
        "replacementTests": ["__tests__/portal/skill-management.test.ts"],
        "sources": ["src/skills/skill-manager.ts", "src/skills/registry.ts"],
        "reason": "Merged skill management boundaries into the primary suite and removed repeated existence checks."
      },
      {
        "test": "__tests__/services/cooking-chef-qa-validation.test.ts",
        "replacementTests": ["__tests__/services/cooking-chef.test.ts"],
        "sources": ["src/services/cooking-chef.ts", "src/services/cooking-tenant-scope.ts"],
        "reason": "Merged cooking generation, fallback, and tenant boundaries into the primary chef suite."
      },
      {
        "test": "__tests__/services/finance-tracker-qa-validation.test.ts",
        "replacementTests": ["__tests__/services/finance-tracker.test.ts"],
        "sources": ["src/services/finance-tracker.ts"],
        "reason": "Merged finance parsing, validation, and tenant behavior into the primary tracker suite."
      },
      {
        "test": "__tests__/services/training-skill-hardening-source-contract.test.ts",
        "replacementTests": ["__tests__/services/coach-kernel-planner.test.ts", "__tests__/services/coach-kernel-feedback-analysis.test.ts", "__tests__/services/training-catalog-validation.test.ts", "__tests__/services/garmin-coach-user-scope.test.ts", "__tests__/api/training-plan-generation.test.ts"],
        "sources": ["src/services/coach-kernel/knowledge-loader.ts", "src/services/coach-kernel/planner-engine.ts", "src/services/coach-kernel/feedback-analysis.ts", "src/api/routes/training-plan-generation.ts"],
        "reason": "Converted broad source-string checks to module-owned behavioral, catalog, metering, and AST policy tests."
      },
      {
        "test": "__tests__/services/usage-metering-qa-validation.test.ts",
        "replacementTests": ["__tests__/services/usage-metering.test.ts"],
        "sources": ["src/services/usage-metering.ts", "src/portal/snapshot-builder.ts"],
        "reason": "Merged schema, aggregation, isolation, and provider metering contracts into the migrated-template primary suite."
      },
      {
        "test": "__tests__/services/webhook-registry-qa-validation.test.ts",
        "replacementTests": ["__tests__/services/webhook-registry.test.ts"],
        "sources": ["src/services/webhook-registry.ts"],
        "reason": "Merged registry validation, retries, and tenant behavior into the primary webhook suite."
      },
      {
        "test": "__tests__/skills/secretary-skill-package-qa-validation.test.ts",
        "replacementTests": ["__tests__/skills/secretary-skill-package.test.ts"],
        "sources": ["src/skills/skill-config.ts", "src/skills/skill-manager.ts"],
        "reason": "Merged Secretary package contracts into the primary skill package suite."
      },
      {
        "test": "__tests__/skills/skills-command-qa-validation.test.ts",
        "replacementTests": ["__tests__/skills/skills-command.test.ts"],
        "sources": ["src/skills/skill-config.ts", "src/skills/skill-manager.ts"],
        "reason": "Merged command parsing, status, and toggle boundaries into the primary skills command suite."
      },
      {
        "test": "__tests__/skills/sub-skill-arch-qa-validation.test.ts",
        "replacementTests": ["__tests__/skills/skill-config.test.ts", "__tests__/skills/skill-manager.test.ts", "__tests__/skills/registry.test.ts"],
        "sources": ["src/skills/skill-config.ts", "src/skills/skill-manager.ts", "src/skills/registry.ts"],
        "reason": "Converted architecture source scans into typed config, manager, and registry contract suites."
      }
    ],
    "exceptions": []
  }
}
