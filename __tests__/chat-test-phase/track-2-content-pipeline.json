{
  "suite": "track-2-content-pipeline",
  "expected_pass_rate": 0.97,
  "scenarios": [
    {
      "id": "content-pipeline-filmed-en",
      "user_text": "Mark the recovery reel as filmed",
      "locale": "en-US",
      "expected_action": "content_pipeline_stage_transition",
      "expected_slots": {
        "topicTitle": "recovery reel",
        "targetStage": "filmed"
      },
      "expected_verifier": "verified_success",
      "expected_response_substring": ["recovery reel", "pipeline"],
      "forbidden_response_substring": ["Telegram", "filmed command"]
    },
    {
      "id": "content-pipeline-editing-en",
      "user_text": "Move the morning routine reel to editing",
      "locale": "en-US",
      "expected_action": "content_pipeline_stage_transition",
      "expected_slots": {
        "topicTitle": "morning routine reel",
        "targetStage": "editing"
      },
      "expected_verifier": "verified_success",
      "expected_response_substring": ["morning routine reel", "editing"]
    },
    {
      "id": "content-pipeline-published-pt",
      "user_text": "Marca o vídeo de mobilidade como publicado https://youtu.be/abc123def45",
      "locale": "pt-PT",
      "expected_action": "content_publish_now",
      "expected_verifier": "refused",
      "expected_response_substring": ["Não consigo publicar", "Não fiz alterações"],
      "forbidden_response_substring": ["verifiquei no pipeline", "verified_success"]
    },
    {
      "id": "content-schedule-vs-published-es",
      "user_text": "Publica este reel mañana",
      "locale": "es-ES",
      "expected_action": "content_publish_now",
      "expected_action_NOT": "content_pipeline_stage_transition",
      "expected_verifier": "refused",
      "expected_response_substring": ["No puedo publicar", "No hice cambios"],
      "forbidden_response_substring": ["stage transition", "verified_success"]
    }
  ]
}
