# Nexus Hub — production backend image.
#
# This is the deployable artifact. Its published OCI digest, not an assumption
# of byte-for-byte rebuild reproducibility, is what a release trusts. Base
# images are digest-pinned and npm dependencies come from the committed
# lockfile; build-time OS package indexes remain external inputs.
#
# Differences from Dockerfile.node (the local-development image) are all
# deliberate:
#   - production dependencies only, so no tsx/vitest in the runtime; the locked
#     TypeScript compiler remains because generated TypeScript artifacts are
#     validated locally with no install or network fallback
#   - no watch mode; PID 1 runs the compiled entrypoint under tini
#   - a non-root runtime user, because this image runs unattended on the VPS
#   - no migration capability at boot: MIGRATIONS_MODE=external makes the app
#     verify the SQL ledger and exact release data-maintenance receipt; the
#     one-shot migrator is the only process that performs either class of change

# ───────────────────────────────────────────────────────────────── build deps
FROM node:22.23.1-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS deps
WORKDIR /app

# better-sqlite3 compiles native bindings. The toolchain is discarded with this
# stage; only the compiled node_modules tree is carried forward.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# ─────────────────────────────────────────────────────────── production deps
FROM node:22.23.1-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS prod-deps
WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
 && test -x node_modules/.bin/tsc

# ────────────────────────────────────────────────────────────────────── build
FROM node:22.23.1-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS build
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=4096
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build \
 && test -f dist/index.js \
 && test -f dist/tools/run-release-migrations.js

# ──────────────────────────────────────────────────────────────────── runtime
FROM node:22.23.1-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS runtime
WORKDIR /app

# curl backs the container healthcheck; sqlite3 backs the read-only integrity
# probe the release observation runs. tini reaps children and forwards signals.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl sqlite3 tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 nexus \
 && useradd --system --uid 10001 --gid nexus --home-dir /app --shell /usr/sbin/nologin nexus

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json package-lock.json ./
COPY config ./config
COPY migrations ./migrations
COPY prompts ./prompts
# The runtime capability manifest validates its governed TypeScript schema
# references by repository-relative path. Preserve the exact contract source it
# names; compiled dist alone cannot satisfy that integrity check.
COPY src/services/chat-turn-contract.ts ./src/services/chat-turn-contract.ts
# The compiled scheduler resolves this tenant-isolation watcher helper from
# process.cwd(). Package the exact production script it executes; omitting the
# scripts tree makes the daily safety scan fail closed on every container run.
COPY scripts/cleanup-tainted-garmin-sessions.mjs ./scripts/cleanup-tainted-garmin-sessions.mjs
# Governed runtime data resolved from process.cwd(); the release attestation
# surfaced on /health/detailed reads it.
COPY catalog ./catalog

ENV NODE_ENV=production
# The application must never migrate on its own in a release container.
ENV MIGRATIONS_MODE=external
# src/config.ts reads PORTAL_PORT; the container listens on all interfaces
# because the published port is bound to loopback on the host instead.
ENV PORTAL_PORT=8200
ENV PORTAL_BIND=0.0.0.0
ENV PORTAL_PUBLIC_BIND_ACK=production-public-host-reviewed

# The database, backups and other mutable state live on a host mount so an
# image swap never touches data.
VOLUME ["/app/data"]

EXPOSE 8200

HEALTHCHECK --interval=10s --timeout=5s --start-period=45s --retries=12 \
  CMD curl -fsS http://127.0.0.1:8200/health || exit 1

USER nexus:nexus
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/index.js"]
