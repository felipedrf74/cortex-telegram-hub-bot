[Unit]
Description=Nexus durable Ollama 24-hour observation %i
After=local-fs.target network-online.target ollama.service
Wants=network-online.target
Requisite=ollama.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/nexus-ollama-observation-control.mjs run %i
TimeoutStartSec=25h30min
TimeoutStopSec=30s
KillSignal=SIGTERM
Restart=no
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true
LockPersonality=true
