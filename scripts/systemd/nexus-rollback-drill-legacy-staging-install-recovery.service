[Unit]
Description=Recover interrupted Nexus legacy staging drill installation
DefaultDependencies=no
After=local-fs.target
Before=nexus-rollback-drill-legacy-staging-recovery.service nexus-release-layout-install-recovery.service pm2-dominguez.service pm2-root.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/nexus-rollback-drill-legacy-staging-install recover-journal
TimeoutStartSec=180s
KillMode=control-group
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/nexus-release /etc/systemd/system /etc/sudoers.d /usr/local/libexec /usr/local/sbin
ReadWritePaths=/home/dominguez/telegram-hub-bot-staging
ReadWritePaths=/var/lib/nexus-rollback-drill-legacy-staging
ReadWritePaths=/var/lib/nexus-release-promotion /run/lock
RestrictAddressFamilies=AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
RequiredBy=pm2-dominguez.service pm2-root.service
