[Unit]
Description=Temporary governed PM2 daemon for sequential Nexus boot recovery
DefaultDependencies=no
After=local-fs.target
Before=pm2-dominguez.service

[Service]
Type=forking
User=dominguez
Group=dominguez
UMask=0077
PIDFile=/home/dominguez/.pm2/pm2.pid
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PM2_HOME=/home/dominguez/.pm2"
Environment="PM2_DAEMON_TITLE=NexusPM2:/opt/nexus-release/pm2/6.0.14"
UnsetEnvironment=NODE_OPTIONS NODE_PATH PM2_NODE_OPTIONS PYTHONPATH PYTHONHOME PYTHONINSPECT PYTHONSTARTUP PYTHONBREAKPOINT LD_PRELOAD LD_LIBRARY_PATH
ExecStart=/usr/local/bin/pm2 ping
ExecStop=/usr/local/bin/pm2 kill
Restart=no
TimeoutStartSec=25s
TimeoutStopSec=25s
KillMode=control-group
SendSIGKILL=yes
MemoryDenyWriteExecute=false
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/home/dominguez /srv/nexus-release
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
