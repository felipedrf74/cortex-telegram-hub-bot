[Unit]
Description=Recover interrupted Nexus release-layout control installation
DefaultDependencies=no
Wants=nexus-rollback-drill-legacy-staging-install-recovery.service
After=local-fs.target nexus-rollback-drill-legacy-staging-install-recovery.service
Before=nexus-release-layout-recovery.service nexus-release-promotion-recovery.service pm2-dominguez.service pm2-root.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/nexus-release-layout-activation-install recover-phase-a
TimeoutStartSec=180s
KillMode=control-group
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/nexus-release /etc/systemd/system /etc/sudoers.d /usr/local/libexec /usr/local/sbin /srv/nexus-release /var/lib/nexus-release-promotion /var/lib/nexus-rollback-drill-legacy-staging /run/lock
RestrictAddressFamilies=AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
