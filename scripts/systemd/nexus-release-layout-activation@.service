[Unit]
Description=Nexus one-time release-layout activation %i
Requires=nexus-release-layout-install-recovery.service
After=local-fs.target nexus-release-layout-install-recovery.service
ConditionPathExists=!/var/lib/nexus-release-promotion/bootstrap-in-progress.v1

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/nexus-release-layout-activation-control run %i
Restart=on-failure
RestartPreventExitStatus=64 75 76 77
RestartSec=2s
TimeoutStartSec=15min
TimeoutStopSec=120s
KillSignal=SIGTERM
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/dominguez /srv/nexus-release /var/lib/nexus-release-promotion /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
