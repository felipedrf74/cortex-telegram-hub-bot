[Unit]
Description=Recover interrupted Nexus release promotion transactions
DefaultDependencies=no
After=local-fs.target
Before=network.target network-online.target multi-user.target pm2-dominguez.service pm2-root.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nexus-release-promotion-control recover-all
TimeoutStartSec=130s

[Install]
WantedBy=multi-user.target
