[Unit]
Description=Recover interrupted non-promotable legacy staging drill
ConditionPathExists=/var/lib/nexus-rollback-drill-legacy-staging/install-receipt.v1.json
DefaultDependencies=no
Requires=nexus-rollback-drill-legacy-staging-install-recovery.service
After=local-fs.target nexus-rollback-drill-legacy-staging-install-recovery.service
Before=network.target network-online.target multi-user.target
Before=pm2-dominguez.service pm2-root.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/nexus-rollback-drill-legacy-staging-broker recover-all
TimeoutStartSec=300s
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/dominguez/telegram-hub-bot-staging
ReadWritePaths=/home/dominguez/.pm2
ReadWritePaths=/var/lib/nexus-rollback-drill-legacy-staging
ReadWritePaths=/var/lib/nexus-release-promotion
ReadWritePaths=/run/lock
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
NoNewPrivileges=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
RequiredBy=pm2-dominguez.service pm2-root.service
