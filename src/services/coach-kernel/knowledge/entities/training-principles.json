{
  "sciencePolicyVersion": "1.0.0",
  "volumeGrowthCapsPct": {
    "running": 8,
    "cycling": 12,
    "swimming": 15,
    "strength": 10
  },
  "maxHardSessionsPerWeek": {
    "running": 2,
    "cycling": 2,
    "swimming": 2
  },
  "marathon": {
    "maxLongRunRatioPct": 35,
    "minimumEasyDaysAfterLongRun": 1
  },
  "hybrid": {
    "maxLowerBodyStrengthDuringRaceBlock": 2,
    "minimumEffectiveDoseStrength": 1
  },
  "triathlon": {
    "maxBricksPerWeek": 1,
    "minimumSwimSessions": 2
  },
  "exerciseSelection": {
    "byPhase": {
      "base": {
        "compoundEmphasisPct": 70,
        "isolationShareMaxPct": 30,
        "noveltyTolerance": "high",
        "intentNote": "Base phase rewards movement quality and capacity build. Allow exercise variation week-to-week to expose the athlete to a broad pattern repertoire."
      },
      "build": {
        "compoundEmphasisPct": 60,
        "isolationShareMaxPct": 30,
        "noveltyTolerance": "low",
        "intensityPriority": "increase",
        "intentNote": "Build phase locks exercise selection so progression signal is interpretable. Vary load/reps/tempo, not exercise identity."
      },
      "peak": {
        "compoundEmphasisPct": 80,
        "isolationShareMaxPct": 20,
        "noveltyTolerance": "none",
        "intensityPriority": "max",
        "intentNote": "Peak phase keeps the exact compound stack from build and pushes intensity. New exercises are explicitly disallowed."
      },
      "taper": {
        "compoundEmphasisPct": 70,
        "isolationShareMaxPct": 30,
        "noveltyTolerance": "none",
        "intensityPriority": "preserve",
        "intentNote": "Taper preserves stimulus signature while reducing fatigue. Keep exercises and intensity, drop volume."
      },
      "race": {
        "compoundEmphasisPct": 0,
        "isolationShareMaxPct": 100,
        "noveltyTolerance": "none",
        "intensityPriority": "minimum",
        "intentNote": "Race week is dress rehearsal only. No new stimulus."
      },
      "deload": {
        "compoundEmphasisPct": 50,
        "isolationShareMaxPct": 50,
        "noveltyTolerance": "moderate",
        "intensityPriority": "low",
        "intentNote": "Deload allows movement variety at low load. Use it to address weak patterns without accumulating fatigue."
      },
      "maintenance": {
        "compoundEmphasisPct": 60,
        "isolationShareMaxPct": 40,
        "noveltyTolerance": "moderate",
        "intentNote": "Maintenance phase keeps tissue resilience. Bias toward minimum effective dose. Variety is a bonus, not a requirement."
      }
    },
    "byExperience": {
      "novice": {
        "complexityMax": "intermediate",
        "spinalLoadingMax": "moderate",
        "sessionPatternCountMax": 4,
        "tempoProgressionAllowed": false,
        "minimumWarmupMinutes": 10,
        "intentNote": "Novices need few patterns repeated frequently to learn. Cap session breadth and skip advanced/expert lifts until form is grooved."
      },
      "intermediate": {
        "complexityMax": "advanced",
        "spinalLoadingMax": "high",
        "sessionPatternCountMax": 6,
        "tempoProgressionAllowed": true,
        "minimumWarmupMinutes": 8,
        "intentNote": "Intermediates can handle full pattern surface. Tempo and pause variants become available as progression knobs."
      },
      "advanced": {
        "complexityMax": "expert",
        "spinalLoadingMax": "high",
        "sessionPatternCountMax": 8,
        "tempoProgressionAllowed": true,
        "minimumWarmupMinutes": 6,
        "intentNote": "Advanced athletes can use the full catalog including expert-tier lifts and complex tempo schemes."
      }
    },
    "byEquipment": {
      "bodyweight_only": {
        "preferredFamilies": ["calisthenics_strength", "calisthenics_volume", "calisthenics_full_body", "calisthenics_endurance"],
        "primaryProgressionVector": "tempo",
        "secondaryProgressionVector": "leverage",
        "tertiaryProgressionVector": "reps",
        "intentNote": "Bodyweight athletes progress via tempo and leverage manipulation, not load. Reps are the last knob to turn."
      },
      "bodyweight_plus_bar": {
        "preferredFamilies": ["calisthenics_skill", "calisthenics_volume", "vertical_pull", "horizontal_push"],
        "primaryProgressionVector": "leverage",
        "secondaryProgressionVector": "tempo",
        "tertiaryProgressionVector": "reps",
        "intentNote": "Pull-up bar unlocks vertical pulling progressions. Otherwise treat like bodyweight_only."
      },
      "dumbbells_only": {
        "preferredFamilies": ["bilateral_squat", "bilateral_hinge", "single_leg_squat", "horizontal_push", "horizontal_pull"],
        "primaryProgressionVector": "load",
        "secondaryProgressionVector": "tempo",
        "tertiaryProgressionVector": "reps",
        "intentNote": "Dumbbells favor unilateral and stable bilateral work. Skip max-strength low-rep schemes; lean into hypertrophy ranges."
      },
      "full_gym": {
        "preferredFamilies": ["bilateral_squat", "bilateral_hinge", "horizontal_push", "vertical_pull", "vertical_push", "power_hinge"],
        "primaryProgressionVector": "load",
        "secondaryProgressionVector": "volume",
        "tertiaryProgressionVector": "tempo",
        "intentNote": "Full gym unlocks the entire compound stack. Progression should run on linear or undulating load schemes."
      }
    }
  },
  "progressionRules": [
    {
      "id": "linear_load_increment_strength",
      "trigger": {
        "metric": "all_target_reps_hit",
        "windowSessions": 2,
        "rpeAvgUnder": 8
      },
      "action": {
        "kind": "increment_load_pct",
        "amount": 2.5,
        "appliesTo": ["bilateral_squat", "bilateral_hinge", "horizontal_push", "vertical_push"]
      },
      "rationale": "If the athlete completes target reps at sub-RPE 8 for two consecutive sessions, the lift is ready for a 2.5% load bump."
    },
    {
      "id": "rep_progression_hypertrophy",
      "trigger": {
        "metric": "top_set_reps_hit",
        "windowSessions": 1,
        "rirAtLeast": 2
      },
      "action": {
        "kind": "increment_reps",
        "amount": 1,
        "appliesTo": ["horizontal_pull", "horizontal_push", "single_leg_squat", "core_anti_extension"]
      },
      "rationale": "For accessory work, add a rep when the top set still leaves 2+ reps in reserve."
    },
    {
      "id": "tempo_progression_calisthenics",
      "trigger": {
        "metric": "top_set_reps_hit",
        "windowSessions": 2,
        "exerciseEquipmentEmpty": true
      },
      "action": {
        "kind": "tempo_eccentric_increment",
        "amount": 1,
        "appliesTo": ["calisthenics_strength", "calisthenics_volume", "calisthenics_full_body"]
      },
      "rationale": "Bodyweight lifts can't grow load-wise. When reps top out, increase eccentric tempo by 1s to extend time-under-tension."
    },
    {
      "id": "leverage_progression_calisthenics",
      "trigger": {
        "metric": "tempo_top_reached",
        "tempoEccentricSec": 5
      },
      "action": {
        "kind": "advance_progression_level",
        "appliesTo": ["calisthenics_strength", "calisthenics_volume", "calisthenics_full_body"]
      },
      "rationale": "When eccentric tempo hits 5s and reps are still hit, the next progression level (harder leverage variant) is unlocked."
    },
    {
      "id": "deload_after_missed_keys",
      "trigger": {
        "metric": "missed_key_session_count",
        "atLeast": 1
      },
      "action": {
        "kind": "hold_volume_flat",
        "scope": "current_week"
      },
      "rationale": "If a key session was missed, do not progress volume that week. Re-baseline before pushing again."
    },
    {
      "id": "deload_high_soreness",
      "trigger": {
        "metric": "soreness_high_or_pain_moderate",
        "phaseNot": ["peak", "race"]
      },
      "action": {
        "kind": "deload_load_pct",
        "amount": -10,
        "appliesTo": ["all_strength"]
      },
      "rationale": "Persistent high soreness or moderate pain drops load 10% next session, preserving the movement pattern."
    },
    {
      "id": "low_readiness_intensity_cap",
      "trigger": {
        "metric": "readiness_orange_or_red"
      },
      "action": {
        "kind": "cap_intensity_zone",
        "max": "tempo",
        "appliesTo": ["all_endurance"]
      },
      "rationale": "Yellow/red readiness suppresses threshold and VO2 work for the day. Aerobic base preserves fitness without piling on stress."
    }
  ],
  "fatigueModulation": {
    "veryHighFatigueRules": {
      "maxBackToBackHardDays": 0,
      "minimumRecoveryDayAfter": 1,
      "spinalLoadingHighMaxPerWeek": 2
    },
    "highFatigueRules": {
      "maxBackToBackHardDays": 1,
      "minimumRecoveryDayAfter": 1,
      "spinalLoadingHighMaxPerWeek": 3
    },
    "interferenceRules": {
      "minutesBetweenStrengthAndKeyEndurance": 360,
      "avoidSameDayKeyEnduranceWithMaxStrength": true,
      "intentNote": "Six hours between heavy strength and key endurance protects the higher-priority discipline. If schedule forces same-day, key endurance comes first."
    }
  },
  "sessionRoleRotation": {
    "strengthFocusOrderForFiveDayWeek": [
      "lower_squat_focus",
      "upper_horizontal_push",
      "lower_hinge_focus",
      "upper_vertical_pull",
      "single_leg_emphasis"
    ],
    "strengthFocusOrderForFourDayWeek": [
      "upper_horizontal_push",
      "lower_squat_focus",
      "upper_vertical_pull",
      "lower_hinge_focus"
    ],
    "strengthFocusOrderForThreeDayWeek": [
      "full_body_density",
      "lower_squat_focus",
      "upper_vertical_pull"
    ],
    "calisthenicsOrderForFourDayWeek": [
      "calisthenics_skill_strength",
      "calisthenics_volume",
      "calisthenics_full_body",
      "calisthenics_endurance"
    ],
    "intentNote": "Roles must not repeat within a week. Lower/upper alternation is preserved when sessions ≥ 4 days. For three-day weeks, prefer full-body density days to avoid leaving any pattern undertrained."
  },
  "calisthenicsSpecific": {
    "sessionStructure": {
      "openWith": "skill_or_high_tension_primary",
      "thenAccessorySupersetCount": 2,
      "finishWith": "core_skill_or_density_circuit",
      "intentNote": "A calisthenics session opens with the highest-skill movement (handstand work, lever, weighted bodyweight strength) when CNS is fresh, then runs antagonist supersets, then a core/density finisher."
    },
    "progressionPath": {
      "push": ["incline_push_up", "knee_push_up", "push_up", "diamond_push_up", "decline_push_up", "pike_push_up", "ring_push_up", "archer_push_up", "wall_walk", "handstand_hold", "handstand_push_up_negative", "handstand_push_up", "one_arm_push_up"],
      "pull": ["scapular_pull_up", "band_assisted_pull_up", "negative_pull_up", "ring_row", "inverted_row", "chin_up", "pull_up", "weighted_pull_up", "archer_pull_up", "l_sit_pull_up", "muscle_up"],
      "legs": ["bodyweight_squat", "lunging_iso_hold", "step_up", "split_squat", "bulgarian_split_squat", "assisted_pistol_squat", "box_pistol_squat", "pistol_squat", "shrimp_squat"],
      "core": ["plank", "dead_bug", "side_plank", "hollow_hold", "hollow_rocks", "l_sit_tuck", "dragon_flag_tuck", "l_sit_hold", "ab_wheel_rollout", "dragon_flag", "v_sit"],
      "intentNote": "Each path is ordered by progression difficulty. The engine advances along the path when the athlete completes target reps with target tempo for two consecutive sessions."
    },
    "tempoProgressionScheme": {
      "default": "2-0-1-0",
      "intermediate": "3-1-1-0",
      "advanced": "5-1-1-0",
      "isometric_emphasis": "2-3-1-0",
      "intentNote": "Tempo digits = eccentric / bottom pause / concentric / top pause in seconds. The intermediate scheme is the workhorse for hypertrophy. Advanced (5s eccentric) is the gating tempo before unlocking the next leverage variant."
    }
  },
  "mesocycleLengths": {
    "default": 4,
    "advanced": 3,
    "novice": 5,
    "intentNote": "Default 3:1 (3 build + 1 deload) mesocycle. Advanced athletes tolerate 2:1; novices benefit from 4:1 with longer recovery."
  },
  "blockTemplates": {
    "accumulation_4wk": ["accumulation", "accumulation", "accumulation", "deload"],
    "accumulation_3wk_advanced": ["accumulation", "accumulation", "deload"],
    "accumulation_5wk_novice": ["accumulation", "accumulation", "accumulation", "accumulation", "deload"],
    "intensification_4wk": ["intensification", "intensification", "intensification", "deload"],
    "realization_3wk": ["realization", "realization", "deload"],
    "taper_2wk_A_race": ["taper", "race"],
    "taper_1wk_B_race": ["taper"],
    "post_race_recovery_1wk": ["post_race_recovery"]
  },
  "weekIntentDefaults": {
    "accumulation": { "volumeMultiplier": 1.0, "intensityFloor": "aerobic", "intensityCeiling": "threshold", "primaryQuality": "volume", "sorenessSensitive": false },
    "intensification": { "volumeMultiplier": 0.9, "intensityFloor": "tempo", "intensityCeiling": "vo2", "primaryQuality": "intensity", "sorenessSensitive": false },
    "realization": { "volumeMultiplier": 0.85, "intensityFloor": "threshold", "intensityCeiling": "neuromuscular", "primaryQuality": "specificity", "sorenessSensitive": true },
    "deload": { "volumeMultiplier": 0.6, "intensityFloor": "recovery", "intensityCeiling": "tempo", "primaryQuality": "recovery", "sorenessSensitive": true },
    "recovery": { "volumeMultiplier": 0.5, "intensityFloor": "recovery", "intensityCeiling": "aerobic", "primaryQuality": "recovery", "sorenessSensitive": true },
    "taper": { "volumeMultiplier": 0.5, "intensityFloor": "tempo", "intensityCeiling": "vo2", "primaryQuality": "sharpness", "sorenessSensitive": true },
    "race": { "volumeMultiplier": 0.3, "intensityFloor": "race", "intensityCeiling": "race", "primaryQuality": "race", "sorenessSensitive": true },
    "post_race_recovery": { "volumeMultiplier": 0.4, "intensityFloor": "recovery", "intensityCeiling": "aerobic", "primaryQuality": "recovery", "sorenessSensitive": true }
  },
  "intensityDistributionModels": {
    "polarized": { "low": 0.80, "moderate": 0.05, "high": 0.15, "evidence": "Seiler 2010; Stöggl & Sperlich 2014" },
    "pyramidal": { "low": 0.75, "moderate": 0.20, "high": 0.05, "evidence": "Sperlich pyramidal review" },
    "thresholdFocused": { "low": 0.65, "moderate": 0.25, "high": 0.10, "evidence": "Niche; sprint-distance and threshold-focused phases" },
    "defaultBySport": {
      "running": "polarized",
      "cycling": "polarized",
      "swimming": "pyramidal",
      "triathlon": "polarized"
    },
    "defaultByLevel": {
      "novice": "pyramidal",
      "intermediate": "polarized",
      "advanced": "polarized"
    },
    "accountingDefault": "segment_time_in_zone",
    "accountingNote": "Default 'segment_time_in_zone' (A2b segments). Weekly summary view can also surface 'session_goal' counting."
  },
  "taperCoefficients": {
    "exponentialBase": 0.85,
    "minimumVolumePct": 40,
    "maximumVolumePct": 60,
    "byPriority": {
      "A": { "durationDays": 14, "volumeDropPct": 55, "intensityPreservedPct": 100, "strengthCutoffDaysBeforeRace": 7 },
      "B": { "durationDays": 7, "volumeDropPct": 45, "intensityPreservedPct": 100, "strengthCutoffDaysBeforeRace": 3 },
      "C": { "durationDays": 3, "volumeDropPct": 35, "intensityPreservedPct": 100, "strengthCutoffDaysBeforeRace": 2 }
    },
    "evidence": "Mujika & Padilla 2003; Bosquet 2007 meta — 41-60% volume drop, intensity preserved."
  },
  "acwrThresholds": {
    "lowRisk": { "min": 0.8, "max": 1.3 },
    "moderateRisk": { "min": 1.3, "max": 1.5 },
    "highRisk": { "min": 1.5, "max": 100 },
    "underTraining": { "min": 0, "max": 0.8 },
    "evidence": "Gabbett 2016; tempered by Impellizzeri 2020 — ACWR is a soft signal, never a sole trigger.",
    "softSignalNote": "Cold-start (<14d completions) disables ACWR-based decisions. Coupled window signals marked low-confidence."
  },
  "riskScoreWeights": {
    "acwrElevated": 0.20,
    "hrvDropPersisted": 0.20,
    "sleepDeficit": 0.15,
    "painElevated": 0.30,
    "adherenceCollapse": 0.10,
    "rapidLoadRamp": 0.15,
    "recentGapOrIllness": 0.20,
    "rationale": "Sum of weights > 1.0 by design — risk is multiplicatively compositional; deload fires at sum ≥ 0.40 with ≥2 contributing signals."
  },
  "deloadCadenceRules": {
    "minWeeksBetweenDeloads": 2,
    "maxWeeksBetweenDeloads": 5,
    "scheduledCadenceByLevel": {
      "novice": 5,
      "intermediate": 4,
      "advanced": 3
    },
    "dataInformedTriggerThresholdScore": 0.4,
    "evidence": "Bompa 2018; Issurin 2010 — 3:1 / 4:1 / 2:1 mesocycle ratios."
  },
  "returnFromGapRamps": {
    "vacation_or_life_gap": {
      "weekOnePct": 60,
      "weeklyIncreasePct": 15,
      "weeksToFullLoad": 3,
      "intensityCapZone": "tempo"
    },
    "minor_illness_resolved": {
      "weekOnePct": 50,
      "weeklyIncreasePct": 12,
      "weeksToFullLoad": 4,
      "intensityCapZone": "aerobic"
    },
    "febrile_or_systemic_illness": {
      "weekOnePct": 30,
      "weeklyIncreasePct": 8,
      "weeksToFullLoad": 6,
      "intensityCapZone": "recovery",
      "additionalNote": "Fever/COVID/prolonged fatigue: medical clearance recommended before any high intensity."
    },
    "injury_localized": {
      "weekOnePct": 40,
      "weeklyIncreasePct": 10,
      "weeksToFullLoad": 5,
      "intensityCapZone": "aerobic"
    },
    "post_exertional_symptom_risk": {
      "weekOnePct": 20,
      "weeklyIncreasePct": 5,
      "weeksToFullLoad": 8,
      "intensityCapZone": "recovery",
      "additionalNote": "Possible post-viral / post-exertional symptoms; pace gently and watch for symptom return."
    },
    "unknown_conservative": {
      "weekOnePct": 50,
      "weeklyIncreasePct": 10,
      "weeksToFullLoad": 5,
      "intensityCapZone": "aerobic"
    },
    "evidence": "Kreher 2012; NSCA 2017; CSCCa/NSCA safe return-to-training guidance — transition periods after inactivity require upper limits on volume, intensity, and work:rest ratios in the first 2-4 weeks."
  },
  "missedSessionPolicyDefaults": {
    "easy_aerobic": "drop",
    "strength_accessory": "drop_or_merge",
    "key_interval_tempo": "reschedule_if_recovery_window",
    "long_run_ride": "reschedule_or_shortened_aerobic",
    "taper_session": "drop_never_cram",
    "rescheduleWindowHoursBeforeNextHighIntensity": 48
  },
  "minimumViableWeekTemplates": {
    "endurance_athlete": [
      { "role": "key_endurance", "sessionType": "threshold_run", "durationMinutes": 45 },
      { "role": "aerobic_maintenance", "sessionType": "easy_run", "durationMinutes": 35 },
      { "role": "strength_micro", "sessionType": "mobility", "durationMinutes": 20 }
    ],
    "strength_athlete": [
      { "role": "key_lift", "sessionType": "strength", "durationMinutes": 45 },
      { "role": "accessory_micro", "sessionType": "strength", "durationMinutes": 25 },
      { "role": "mobility", "sessionType": "mobility", "durationMinutes": 15 }
    ],
    "hybrid_athlete": [
      { "role": "key_endurance", "sessionType": "threshold_run", "durationMinutes": 40 },
      { "role": "key_lift", "sessionType": "strength", "durationMinutes": 40 },
      { "role": "mobility", "sessionType": "mobility", "durationMinutes": 15 }
    ],
    "intentNote": "Minimum viable week — fewer decisions, shorter sessions, clearer priorities. Used by C8 low-adherence policy."
  }
}
