# Telegram
TELEGRAM_BOT_TOKEN=your_botfather_token
TELEGRAM_ALLOWED_USER_IDS=123456789   # Comma-separated — owner + legacy allowed IDs
OWNER_TELEGRAM_ID=                    # Explicit canonical owner identity; required for owner AI access
REGISTRATION_OPEN=false               # Set to 'true' to allow registration without invite codes

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Google (OAuth2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Apple Sign in on the web (browser /user login)
# APPLE_WEB_CLIENT_ID must be the Apple Services ID, not the native bundle ID.
APPLE_WEB_CLIENT_ID=
APPLE_WEB_REDIRECT_URI=https://api.nexushub.me/oauth/apple/callback

# Outlook / Microsoft Graph (OAuth2) — for Hotmail/Outlook calendar & email
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=consumers           # Use 'consumers' for personal Microsoft accounts (Hotmail/Outlook.com)
OUTLOOK_REFRESH_TOKEN=

# Microsoft To Do (uses same Outlook credentials above)
# IMPORTANT: Azure App must have Tasks.ReadWrite (Delegated) permission
# Re-run scripts/get-outlook-token-v2.ts after adding the permission
TODO_DEFAULT_LIST=Tasks
TODO_DIGEST_ENABLED=true
TODO_DIGEST_TIME=08:00

# Invoice Filing (SSH/SCP to Mac via autossh reverse tunnel)
# Mac must run: autossh -R 2222:localhost:22 user@server
INVOICE_FILING_ENABLED=true
INVOICE_SSH_HOST=localhost
INVOICE_SSH_PORT=2222
INVOICE_SSH_USER=felipedominguez
INVOICE_SSH_KEY=/home/dominguez/.ssh/id_ed25519
INVOICE_REMOTE_PATH=/Users/felipedominguez/Documents/Invoices
# INVOICE_MIN_CONFIDENCE=0.70        # Min confidence to auto-file (default: 0.70)
# INVOICE_COMPRESSION_ENABLED=true   # Compress images before filing
# INVOICE_JPEG_QUALITY=80            # JPEG quality for compression
# INVOICE_MONTHLY_COLLECTION=true    # Enable monthly cron collection (1st of month)

# Amazon.es Invoice Collection (Playwright browser automation)
# Cron: 1st of each month at 09:15 — collects previous month's invoices
AMAZON_COLLECTION_ENABLED=false
AMAZON_EMAIL=
AMAZON_PASSWORD=
# AMAZON_SESSION_PATH=./data/amazon-session.json
# AMAZON_HEADLESS=true

# Uber / Uber Eats Invoice Collection (Playwright browser automation)
# Cron: 1st of each month at 09:30 — collects previous month's invoices
UBER_COLLECTION_ENABLED=false
UBER_EMAIL=
UBER_PASSWORD=
# UBER_SESSION_PATH=./data/uber-session.json
# UBER_HEADLESS=true
# UBER_RIDES_ENABLED=true
# UBER_EATS_ENABLED=true

# Garmin Connect (Daily Coach)
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_PATH=./data/garmin-tokens
GARMIN_COACH_ENABLED=false
GARMIN_COACH_TIME=21:00

# Status Portal
PORTAL_ENABLED=true
PORTAL_PORT=8200
# Bind the portal to loopback and publish it only through the reviewed
# tunnel/reverse-proxy path. Production wildcard binds fail fast unless
# PORTAL_PUBLIC_BIND_ACK=production-public-host-reviewed is set.
PORTAL_BIND=127.0.0.1
# PORTAL_PUBLIC_BIND_ACK=
PORTAL_TOKEN=             # Bearer token for /api/* routes (leave empty for dev/no-auth)
PORTAL_READ_TOKEN=        # Optional read-only portal bearer
PORTAL_WRITE_TOKEN=       # Optional write-capable portal bearer
PORTAL_ADMIN_TOKEN=       # Optional elevated admin bearer for sensitive mutations
# PORTAL_ADMIN_REQUIRE_ACTOR=true
# PORTAL_ADMIN_ACTORS=alice@example.com,bob@example.com
# PORTAL_ADMIN_ACTOR_SIGNATURE_SECRET=  # Optional HMAC secret for signed actor headers
# PORTAL_ADMIN_ACTOR_SIGNATURE_TOLERANCE_MS=300000
# PORTAL_SESSION_SECRET=  # Optional HMAC secret for signed ps_ portal operator sessions
# PORTAL_SESSION_MAX_AGE_MS=28800000
# PORTAL_REQUIRE_SESSION_AUTH=false # true disables static portal bearer credentials
# PORTAL_BETA_HARDENED=false        # true refuses to boot unless admin exposure is beta-safe
#                                   # (disabled / loopback_only / session_only / signed_static)
# PORTAL_OPERATOR_USER_SCOPES=      # Optional JSON: {"operator@example.com":[1,2,3]}
#                                   # When set, :userId admin routes fail 403 if the
#                                   # authenticated operator is not scoped to the target user.

# Training coach v2 — opaque ownership-denial log correlation tag (R6 P3).
# When set, ownership-denied warn logs in the v2 routes use HMAC-SHA256
# keyed by this secret so two log lines for the same foreign owner
# produce the same `u#XXXXXXXX` tag — across processes + across deploys.
# When UNSET, each Node process generates its own random salt at boot;
# tags are correlation-stable within one process but not across. Set
# this in production if your operator workflow correlates ownership
# denials across the cluster. Treat as a secret — leaking it lets a
# log reader pre-compute tags for arbitrary user ids.
# OWNER_ID_HASH_SECRET=

# Public waitlist
# Used to hash visitor IPs for abuse dedupe without storing raw IPs.
# Generate a long random value and keep it stable; rotating it invalidates prior IP hashes.
WAITLIST_IP_SALT=
WAITLIST_CONFIRMATION_TTL_HOURS=24
BETA_INVITE_EXPIRES_DAYS=30
IOS_STATIC_INVITE_EXPIRES_DAYS=365    # Long-lived reviewer/static beta code access; DB-issued invites use BETA_INVITE_EXPIRES_DAYS.

# Transactional email (Resend)
RESEND_API_KEY=
RESEND_FROM="Nexus Hub <welcome@nexushub.me>"

# Stripe Billing (monthly website + iOS subscription state)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=price_1TYUtmEnGIEp1Q5vqsfLN9Ml       # Pro $14.99/mo
STRIPE_PRICE_PRO_MONTHLY_BRL=price_1TYUtnEnGIEp1Q5vMfu5XXt1   # Pro R$74.99/mo
STRIPE_PRICE_MAX_MONTHLY=price_1TYUtoEnGIEp1Q5vievUfmeu       # Max $19.99/mo
STRIPE_PRICE_MAX_MONTHLY_BRL=price_1TYUtpEnGIEp1Q5vtuAejLdn   # Max R$99.99/mo

# WhatsApp Cloud API (optional — enable for WhatsApp channel)
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=                   # Meta App Secret for webhook HMAC verification
WHATSAPP_API_VERSION=v21.0

# App
TIMEZONE=Europe/Lisbon
DATABASE_PATH=./data/bot.db
LOG_LEVEL=info
IOS_API_RATE_LIMIT=60                 # Authenticated non-read requests/minute (mutations + chat/model-triggering POSTs)
IOS_API_READ_RATE_LIMIT=300           # Authenticated GET/HEAD requests/minute for tab navigation and screen refreshes
IOS_API_JWT_SECRET=                   # 32+ byte signing secret; no placeholder text.
IOS_API_JWT_KEYS=                     # Optional JSON keyring; exactly one active key, unique kid values.
IOS_API_JWT_ACTIVE_KID=               # Must exactly match the intended keyring entry.
IOS_JWT_EXPIRY=7d                     # Rotation overlap must be token lifetime +24h, minimum 8 days.
CHAT_CONFIRMATION_HMAC_SECRET=         # Pin before enabling IOS_API_JWT_KEYS; remains stable when the legacy JWT secret rotates.
CHAT_V2_EVIDENCE_HMAC_SECRET=         # Pin independently before enabling IOS_API_JWT_KEYS; remains stable across JWT rotations.

# Error tracking
SENTRY_DSN=                           # REQUIRED in production. Empty disables error tracking.
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Finance + backup encryption
FINANCE_ENCRYPTION_ENABLED=true
FINANCE_ENCRYPTION_KEY=               # REQUIRED in production. Generate with: openssl rand -hex 32
GARMIN_ENCRYPTION_KEY=                # Optional dedicated Garmin key; falls back to OAUTH/FINANCE key
BACKUP_ENABLED=true
BACKUP_ENCRYPT=true                   # REQUIRED in production when BACKUP_ENABLED=true
BACKUP_KEY=                           # REQUIRED in production. Generate with: openssl rand -hex 32

# AI Safety
AI_CALL_TIMEOUT_MS=30000             # 30s timeout on all AI API calls
GLOBAL_DAILY_COST_LIMIT=100.00       # $100/day closed-beta global spend limit; revisit after Wave 2 cost data
COST_ALERT_THRESHOLD=0.80            # Alert at 80% of daily limit
PAID_AI_COST_CONTROLS_ENFORCEMENT_ENABLED=false # Rollout switch: observe first; enable explicitly on staging, then production after owner approval
OWNER_AI_AUTOMATIONS_ENABLED=false   # Owner interactive AI remains available; background AI is opt-in only
CONTENT_CRON_ENGAGEMENT_GATE=on      # Enforced-mode replenishment gate; off is honored only outside production
CHAT_ACTION_FIXER_MODEL=gpt-5.4-nano # Bounded model used for asynchronous action-plan JSON repair
ANTHROPIC_WEB_SEARCH_COST_USD_PER_REQUEST=0.01 # Cost-equivalent list rate; override only when provider pricing changes
OPENAI_WEB_SEARCH_COST_USD_PER_CALL=0.01       # Responses web_search list rate
OPENAI_WEB_SEARCH_MAX_CALLS=1                  # Provider-enforced max_tool_calls (1-10); one bounded search keeps Pro research affordable
GEMINI_GROUNDING_COST_USD_PER_PROMPT=0.035     # Billable rate; do not zero unless the API project's shared free tier is guaranteed isolated
# search_context_size=low is guidance, not an exact injected-token cap.
# With enforcement on, provider-hosted search is interactive-only (125% p95
# reservation + actual accounting); automation/system must use cached signals,
# validated evergreen generation, or defer before network I/O.

# Operator alerts / on-call delivery (optional but required for release-grade paging)
OPERATOR_ALERT_WEBHOOK_URL=          # HTTPS endpoint for PagerDuty/Slack/Zapier/custom on-call webhook
OPERATOR_ALERT_WEBHOOK_TOKEN=        # Optional bearer token for the webhook; never logged
OPERATOR_ALERT_WEBHOOK_TIMEOUT_MS=5000
OPERATOR_ALERT_MAX_DELIVERY_ATTEMPTS=3
OPERATOR_ALERT_RETRY_BASE_MS=60000
OPERATOR_ALERT_DEFAULT_RUNBOOK_URL=docs/OBSERVABILITY-ONCALL.md

# OAuth (per-user token encryption + callback URL)
OAUTH_ENCRYPTION_KEY=                 # Master key for encrypting OAuth tokens (reuse FINANCE_ENCRYPTION_KEY if set)
OAUTH_REDIRECT_BASE=https://api.nexushub.me   # Base URL for OAuth callbacks

# APNs (Apple Push Notification service, token-based authentication)
# All five values come from the Apple Developer Portal under one Team ID.
# When unset, the engine logs ONE warn at startup and silently no-ops on push
# sends. See src/services/apns-sender.ts for the auto-detection logic.
APNS_ENABLED=false                    # 'true' to enable; otherwise sender no-ops
NOTIFICATION_DELIVERY_MODE=mock       # Production APNs requires explicit: apns
APNS_TEAM_ID=                         # 10-char Apple Developer Team ID, e.g. ABC1234567
APNS_KEY_ID=                          # 10-char APNs Auth Key ID, e.g. XYZ9876543
APNS_BUNDLE_ID=me.nexushub.app        # iOS app bundle identifier (apns-topic)
APNS_AUTH_KEY_P8=                     # Either: absolute path to AuthKey_XXXXXXXXXX.p8 OR raw .p8 contents
APNS_ENVIRONMENT=production           # 'production' (api.push.apple.com) or 'sandbox' (api.sandbox.push.apple.com)
                                      #   production = Release / TestFlight / App Store builds
                                      #   sandbox    = Debug / Xcode-installed builds

# Decision Center conflict policy v1. Values: off | shadow | active.
# Boolean-like aliases are intentionally rejected and fail closed to off.
# Shadow classifies and emits privacy-safe telemetry without changing user-visible state.
# Scoped overrides use the existing suffix convention, for example:
# DECISION_CONFLICT_POLICY_V1_ENABLED_TENANT_42=shadow
DECISION_CONFLICT_POLICY_V1_ENABLED=off

# Optimistic Decision Center record-version enforcement (default off for legacy clients).
DECISION_FLOW_V1_ENFORCE_ENABLED=false

# Immutable Training plan revision Milestone 1. Values: off | shadow | active.
# Defaults/fails closed to off. Production active is accepted only through explicit
# personal-account USER/TENANT overrides and also requires Decision Flow v1.
TRAINING_PLAN_REVISION_V1_MODE=off
# Milestone 2 typed phase/block/prescription generation and activation. Default
# off and scoped with the standard _USER_<id> / _TENANT_<id> suffixes. It only
# affects immutable revision candidates and their compatibility projection; it
# does not change legacy plan writers or existing active plans.
TRAINING_TYPED_WORKOUT_V1_ENABLED=false
# Milestone 3 explicit busy/tired/substitution previews. Values: off | shadow | active.
# Off and shadow never persist previews, proposals, Decisions, revisions or effects.
# Active requires revision active enrollment, typed workouts and Decision Flow v1.
TRAINING_ADAPTATION_V1_MODE=off
# Server-authoritative fresh tired-report thresholds; client counts are ignored.
TRAINING_ADAPTATION_TIRED_WEEK_THRESHOLD=2
TRAINING_ADAPTATION_TIRED_PHASE_THRESHOLD=3
# Suppress materially unchanged rejected adaptation proposals for this many days.
TRAINING_ADAPTATION_REJECTION_COOLDOWN_DAYS=7
# Governed exercise-media metadata delivery. Default off and scoped with the
# standard _USER_<id> / _TENANT_<id> suffixes. Enabling this flag cannot serve
# a draft/unreviewed manifest; catalog, license, review, host, checksum,
# localization, and takedown gates remain authoritative.
TRAINING_EXERCISE_MEDIA_V1_ENABLED=false
# Milestone 4 exact mode/discipline allowlist. Default empty/off. Use scoped
# overrides such as TRAINING_PLAN_M4_ALLOWLIST_USER_42=maintenance:running,event_based:marathon.
# Wildcards and malformed tokens grant no authority; a global non-empty value is forbidden in production.
TRAINING_PLAN_M4_ALLOWLIST=
# Dedicated AES-GCM snapshot key (32+ characters). Required before active writes or backfill apply.
# No Health/OAuth/Finance fallback is accepted. The stored key-version fingerprint fails closed
# if operators change the dedicated key without an approved rotation/keyring migration.
TRAINING_PROFILE_SNAPSHOT_ENCRYPTION_KEY=
# Second operator interlock for the compiled legacy backfill CLI. Keep false for
# dry-run and normal runtime. Apply still additionally requires the exact dry-run
# digest and --confirm=LEGACY_ACTIVE.
TRAINING_PLAN_REVISION_V1_BACKFILL_APPLY_ENABLED=false

# Disabled until the labeled evaluation corpus, shadow cohort, and product owner establish a value (1-90 days).
DECISION_CANDIDATE_REJECTION_COOLDOWN_DAYS=0

# Low-risk Secretary conflict auto-resolution remains unavailable unless both this global/scoped
# switch and a persisted per-user preference are true. Default off; no high-impact action uses it.
DECISION_LOW_RISK_AUTO_RESOLUTION_ENABLED=false

# Structured Secretary reasoning. Values: off | shadow | active.
# Boolean-like aliases are intentionally rejected and fail closed to off.
# Start with shadow for a scoped cohort; active requires validated evidence-bound model JSON.
SECRETARY_REASONING_V1_MODE=off
# Dedicated tenant-scoped HMAC for opaque Decision Center evidence references.
# Required before structured Secretary Decision Center previews can be activated.
# No JWT, cloud-allowlist, shadow-route, or test fallback is accepted.
# When configured, it also keys Secretary candidate identities with a separate domain label.
CHAT_CORE_V2_DECISION_EVIDENCE_HMAC_SECRET=
