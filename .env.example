INVOICE_FILING_ENABLED=true
INVOICE_SSH_HOST=localhost
INVOICE_SSH_PORT=2222
INVOICE_SSH_USER=felipedominguez
INVOICE_SSH_KEY=/home/dominguez/.ssh/id_ed25519
INVOICE_REMOTE_PATH=/Users/felipedominguez/Documents/Invoices
# INVOICE_MIN_CONFIDENCE=0.70        # Min confidence to auto-file (default: 0.70)
# INVOICE_COMPRESSION_ENABLED=true   # Compress images before filing
# INVOICE_JPEG_QUALITY=80            # JPEG quality for compression
# INVOICE_MONTHLY_COLLECTION=true    # Enable monthly cron collection (1st of month)

# Amazon.es Invoice Collection (Playwright browser automation)
