# Owner bootstrap identity (legacy remnant).
# OWNER_TELEGRAM_ID is matched against the persisted legacy identity column to
# resolve the canonical owner row; required for owner AI access until the
# owner-gated identity migration replaces it (see migrations/259_*.sql).
OWNER_TELEGRAM_ID=
REGISTRATION_OPEN=false               # Set to 'true' to allow registration without invite codes

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Google (OAuth2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Apple Sign in on the web (browser /user login)
# APPLE_WEB_CLIENT_ID must be the Apple Services ID, not the native bundle ID.
APPLE_WEB_CLIENT_ID=
APPLE_WEB_REDIRECT_URI=https://api.nexushub.me/oauth/apple/callback

