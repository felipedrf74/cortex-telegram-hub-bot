AMAZON_COLLECTION_ENABLED=false
AMAZON_EMAIL=
AMAZON_PASSWORD=
# AMAZON_SESSION_PATH=./data/amazon-session.json
# AMAZON_HEADLESS=true

# Uber / Uber Eats Invoice Collection (Playwright browser automation)
# Cron: 1st of each month at 09:30 — collects previous month's invoices
UBER_COLLECTION_ENABLED=false
UBER_EMAIL=
UBER_PASSWORD=
# UBER_SESSION_PATH=./data/uber-session.json
# UBER_HEADLESS=true
