# Telegram
TELEGRAM_BOT_TOKEN=your_botfather_token
TELEGRAM_ALLOWED_USER_IDS=123456789   # Comma-separated — ONLY your Telegram user ID(s)

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google (OAuth2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Outlook / Microsoft Graph (OAuth2) — for Hotmail/Outlook calendar & email
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=consumers           # Use 'consumers' for personal Microsoft accounts (Hotmail/Outlook.com)
OUTLOOK_REFRESH_TOKEN=

# Microsoft To Do (uses same Outlook credentials above)
# IMPORTANT: Azure App must have Tasks.ReadWrite (Delegated) permission
# Re-run scripts/get-outlook-token-v2.ts after adding the permission
TODO_DEFAULT_LIST=Tasks
TODO_DIGEST_ENABLED=true
TODO_DIGEST_TIME=08:00

# Invoice Filing (SSH/SCP to Mac via autossh reverse tunnel)
# Mac must run: autossh -R 2222:localhost:22 user@server
INVOICE_FILING_ENABLED=true
INVOICE_SSH_HOST=localhost
INVOICE_SSH_PORT=2222
INVOICE_SSH_USER=felipedominguez
INVOICE_SSH_KEY=/home/dominguez/.ssh/id_ed25519
INVOICE_REMOTE_PATH=/Users/felipedominguez/Documents/Invoices

# App
TIMEZONE=Europe/Lisbon
DATABASE_PATH=./data/bot.db
LOG_LEVEL=info
