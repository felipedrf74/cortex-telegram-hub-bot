# Telegram
TELEGRAM_BOT_TOKEN=your_botfather_token
TELEGRAM_ALLOWED_USER_IDS=123456789   # Comma-separated — owner + legacy allowed IDs
OWNER_TELEGRAM_ID=                    # Explicit owner ID (falls back to TELEGRAM_ALLOWED_USER_IDS[0])
REGISTRATION_OPEN=false               # Set to 'true' to allow registration without invite codes

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Google (OAuth2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Apple Sign in on the web (browser /user login)
# APPLE_WEB_CLIENT_ID must be the Apple Services ID, not the native bundle ID.
APPLE_WEB_CLIENT_ID=
APPLE_WEB_REDIRECT_URI=https://api.nexushub.me/oauth/apple/callback

# Outlook / Microsoft Graph (OAuth2) — for Hotmail/Outlook calendar & email
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=consumers           # Use 'consumers' for personal Microsoft accounts (Hotmail/Outlook.com)
OUTLOOK_REFRESH_TOKEN=

# Microsoft To Do (uses same Outlook credentials above)
# IMPORTANT: Azure App must have Tasks.ReadWrite (Delegated) permission
# Re-run scripts/get-outlook-token-v2.ts after adding the permission
TODO_DEFAULT_LIST=Tasks
TODO_DIGEST_ENABLED=true
TODO_DIGEST_TIME=08:00

# Invoice Filing (SSH/SCP to Mac via autossh reverse tunnel)
# Mac must run: autossh -R 2222:localhost:22 user@server
INVOICE_FILING_ENABLED=true
INVOICE_SSH_HOST=localhost
INVOICE_SSH_PORT=2222
INVOICE_SSH_USER=felipedominguez
INVOICE_SSH_KEY=/home/dominguez/.ssh/id_ed25519
INVOICE_REMOTE_PATH=/Users/felipedominguez/Documents/Invoices
# INVOICE_MIN_CONFIDENCE=0.70        # Min confidence to auto-file (default: 0.70)
# INVOICE_COMPRESSION_ENABLED=true   # Compress images before filing
# INVOICE_JPEG_QUALITY=80            # JPEG quality for compression
# INVOICE_MONTHLY_COLLECTION=true    # Enable monthly cron collection (1st of month)

# Amazon.es Invoice Collection (Playwright browser automation)
# Cron: 1st of each month at 09:15 — collects previous month's invoices
AMAZON_COLLECTION_ENABLED=false
AMAZON_EMAIL=
AMAZON_PASSWORD=
# AMAZON_SESSION_PATH=./data/amazon-session.json
# AMAZON_HEADLESS=true

# Uber / Uber Eats Invoice Collection (Playwright browser automation)
# Cron: 1st of each month at 09:30 — collects previous month's invoices
UBER_COLLECTION_ENABLED=false
UBER_EMAIL=
UBER_PASSWORD=
# UBER_SESSION_PATH=./data/uber-session.json
# UBER_HEADLESS=true
# UBER_RIDES_ENABLED=true
# UBER_EATS_ENABLED=true

# Garmin Connect (Daily Coach)
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_PATH=./data/garmin-tokens
GARMIN_COACH_ENABLED=false
GARMIN_COACH_TIME=21:00

# Status Portal
PORTAL_ENABLED=true
PORTAL_PORT=8200
PORTAL_BIND=0.0.0.0
PORTAL_TOKEN=             # Bearer token for /api/* routes (leave empty for dev/no-auth)
PORTAL_READ_TOKEN=        # Optional read-only portal bearer
PORTAL_WRITE_TOKEN=       # Optional write-capable portal bearer
PORTAL_ADMIN_TOKEN=       # Optional elevated admin bearer for sensitive mutations
# PORTAL_ADMIN_REQUIRE_ACTOR=true
# PORTAL_ADMIN_ACTORS=alice@example.com,bob@example.com
# PORTAL_ADMIN_ACTOR_SIGNATURE_SECRET=  # Optional HMAC secret for signed actor headers
# PORTAL_ADMIN_ACTOR_SIGNATURE_TOLERANCE_MS=300000
# PORTAL_SESSION_SECRET=  # Optional HMAC secret for signed ps_ portal operator sessions
# PORTAL_SESSION_MAX_AGE_MS=28800000
# PORTAL_REQUIRE_SESSION_AUTH=false # true disables static portal bearer credentials
# PORTAL_BETA_HARDENED=false        # true refuses to boot unless admin exposure is beta-safe
#                                   # (disabled / loopback_only / session_only / signed_static)
# PORTAL_OPERATOR_USER_SCOPES=      # Optional JSON: {"operator@example.com":[1,2,3]}
#                                   # When set, :userId admin routes fail 403 if the
#                                   # authenticated operator is not scoped to the target user.

# Training coach v2 — opaque ownership-denial log correlation tag (R6 P3).
# When set, ownership-denied warn logs in the v2 routes use HMAC-SHA256
# keyed by this secret so two log lines for the same foreign owner
# produce the same `u#XXXXXXXX` tag — across processes + across deploys.
# When UNSET, each Node process generates its own random salt at boot;
# tags are correlation-stable within one process but not across. Set
# this in production if your operator workflow correlates ownership
# denials across the cluster. Treat as a secret — leaking it lets a
# log reader pre-compute tags for arbitrary user ids.
# OWNER_ID_HASH_SECRET=

# Public waitlist
# Used to hash visitor IPs for abuse dedupe without storing raw IPs.
# Generate a long random value and keep it stable; rotating it invalidates prior IP hashes.
WAITLIST_IP_SALT=
WAITLIST_CONFIRMATION_TTL_HOURS=24
BETA_INVITE_EXPIRES_DAYS=30
IOS_STATIC_INVITE_EXPIRES_DAYS=365    # Long-lived reviewer/static beta code access; DB-issued invites use BETA_INVITE_EXPIRES_DAYS.

# Transactional email (Resend)
RESEND_API_KEY=
RESEND_FROM="Nexus Hub <welcome@nexushub.me>"

# Stripe Billing (monthly website + iOS subscription state)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=price_1TYUtmEnGIEp1Q5vqsfLN9Ml       # Pro $14.99/mo
STRIPE_PRICE_PRO_MONTHLY_BRL=price_1TYUtnEnGIEp1Q5vMfu5XXt1   # Pro R$74.99/mo
STRIPE_PRICE_MAX_MONTHLY=price_1TYUtoEnGIEp1Q5vievUfmeu       # Max $19.99/mo
STRIPE_PRICE_MAX_MONTHLY_BRL=price_1TYUtpEnGIEp1Q5vtuAejLdn   # Max R$99.99/mo

# WhatsApp Cloud API (optional — enable for WhatsApp channel)
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=                   # Meta App Secret for webhook HMAC verification
WHATSAPP_API_VERSION=v21.0

# App
TIMEZONE=Europe/Lisbon
DATABASE_PATH=./data/bot.db
LOG_LEVEL=info
IOS_API_RATE_LIMIT=60                 # Authenticated non-read requests/minute (mutations + chat/model-triggering POSTs)
IOS_API_READ_RATE_LIMIT=300           # Authenticated GET/HEAD requests/minute for tab navigation and screen refreshes

# Error tracking
SENTRY_DSN=                           # REQUIRED in production. Empty disables error tracking.
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Backup encryption (optional)
BACKUP_ENCRYPT=false
BACKUP_KEY=                           # Required if BACKUP_ENCRYPT=true — 32+ char secret

# AI Safety
AI_CALL_TIMEOUT_MS=30000             # 30s timeout on all AI API calls
GLOBAL_DAILY_COST_LIMIT=100.00       # $100/day closed-beta global spend limit; revisit after Wave 2 cost data
COST_ALERT_THRESHOLD=0.80            # Alert at 80% of daily limit

# Operator alerts / on-call delivery (optional but required for release-grade paging)
OPERATOR_ALERT_WEBHOOK_URL=          # HTTPS endpoint for PagerDuty/Slack/Zapier/custom on-call webhook
OPERATOR_ALERT_WEBHOOK_TOKEN=        # Optional bearer token for the webhook; never logged
OPERATOR_ALERT_WEBHOOK_TIMEOUT_MS=5000
OPERATOR_ALERT_MAX_DELIVERY_ATTEMPTS=3
OPERATOR_ALERT_RETRY_BASE_MS=60000
OPERATOR_ALERT_DEFAULT_RUNBOOK_URL=docs/OBSERVABILITY-ONCALL.md

# OAuth (per-user token encryption + callback URL)
OAUTH_ENCRYPTION_KEY=                 # Master key for encrypting OAuth tokens (reuse FINANCE_ENCRYPTION_KEY if set)
OAUTH_REDIRECT_BASE=https://api.nexushub.me   # Base URL for OAuth callbacks

# APNs (Apple Push Notification service, token-based authentication)
# All five values come from the Apple Developer Portal under one Team ID.
# When unset, the engine logs ONE warn at startup and silently no-ops on push
# sends. See src/services/apns-sender.ts for the auto-detection logic.
APNS_ENABLED=false                    # 'true' to enable; otherwise sender no-ops
APNS_TEAM_ID=                         # 10-char Apple Developer Team ID, e.g. ABC1234567
APNS_KEY_ID=                          # 10-char APNs Auth Key ID, e.g. XYZ9876543
APNS_BUNDLE_ID=me.nexushub.app        # iOS app bundle identifier (apns-topic)
APNS_AUTH_KEY_P8=                     # Either: absolute path to AuthKey_XXXXXXXXXX.p8 OR raw .p8 contents
APNS_ENVIRONMENT=production           # 'production' (api.push.apple.com) or 'sandbox' (api.sandbox.push.apple.com)
                                      #   production = Release / TestFlight / App Store builds
                                      #   sandbox    = Debug / Xcode-installed builds
